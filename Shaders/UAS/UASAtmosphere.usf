// ============================================================
// UAS - Unlimited Atmosphere System
// GPU post-process pipeline test
// ============================================================

#include "/Engine/Public/Platform.ush"

struct FUASAtmosphereVertexOutput
{
    float4 Position : SV_POSITION;
};

// ============================================================
// VERTEX SHADER
// ============================================================

FUASAtmosphereVertexOutput MainVS(
    uint VertexID : SV_VertexID
)
{
    FUASAtmosphereVertexOutput Output;

    float2 Positions[3];

    Positions[0] = float2(-1.0, -1.0);
    Positions[1] = float2(-1.0,  3.0);
    Positions[2] = float2( 3.0, -1.0);

    Output.Position =
        float4(
            Positions[VertexID],
            0.0,
            1.0
        );

    return Output;
}

// ============================================================
// PIXEL SHADER
// ============================================================

float4 MainPS(
    FUASAtmosphereVertexOutput Input
) : SV_Target0
{
    // ========================================================
    // UAS GPU PIPELINE TEST
    //
    // Temporary diagnostic output.
    // If this appears on screen, our custom global shader
    // is successfully modifying the post-process output.
    // ========================================================

    return float4(
        0.05,
        0.25,
        1.0,
        1.0
    );
}