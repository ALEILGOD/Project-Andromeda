// ============================================================
// UAS - Unlimited Atmosphere System
// Initial GPU shader test
// ============================================================

#include "/Engine/Public/Platform.ush"

struct FUASAtmosphereVertexOutput
{
    float4 Position : SV_POSITION;
};

// VERTEX SHADER
FUASAtmosphereVertexOutput MainVS(
    uint VertexID : SV_VertexID
)
{
    FUASAtmosphereVertexOutput Output;

    // Simple fullscreen triangle.
    //
    // This is only a pipeline test.
    // The actual atmosphere geometry/ray setup
    // will be implemented later.

    float2 Positions[3];

    Positions[0] = float2(-1.0, -1.0);
    Positions[1] = float2(-1.0,  3.0);
    Positions[2] = float2( 3.0, -1.0);

    Output.Position =
        float4(
            Positions[VertexID],
            0.0,
            1.0
        );

    return Output;
}