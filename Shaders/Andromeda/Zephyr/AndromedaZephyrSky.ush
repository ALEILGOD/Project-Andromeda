// =========================================================
// ZEPHYR-01 — PLANETARY SKY DOMAIN (shared HLSL library)
// =========================================================
//
// Virtual path:
//     /Andromeda/Zephyr/AndromedaZephyrSky.ush
// Disk path:
//     Shaders/Andromeda/Zephyr/AndromedaZephyrSky.ush
//
// ZEPHYR owns the planetary-sky DOMAIN (planet-centered
// geometry + sky range); ATMOS owns the TRANSPORT (Rayleigh,
// transmittance, optical depth, star transport, multiple
// scattering). This file contains DOMAIN MATH ONLY: no
// scattering coefficients, no phase functions, no LUTs, no
// clouds, no weather, no precipitation.
//
// Absolute invariant (enforced by the min() clamp, mirrors
// FAndromedaZephyrManager::ComputeSkyRange on CPU):
//     ZephyrSkyOuterRadius <= AtmosphereRadius   ALWAYS.
//
// Anti white-ring design:
//   * No second boundary is ever drawn: the Zephyr sky domain
//     is strictly INSIDE the ATMOS shell, and both sides run
//     the SAME transport integrator.
//   * ZephyrSkyWeight is C1-continuous and reaches EXACTLY 0
//     at ZephyrSkyOuterRadius with zero derivative, so any
//     future blending toward the ATMOS outer domain
//     (ZEPHYR-02) cannot produce a ring, seam or hard edge.
//   * All quantities are planet-centered distances, hence
//     invariant under planet rotation/orbit: rotation
//     coherence comes from tracking PlanetCenter, never from
//     assuming World-Z alignment.
//
// ZEPHYR-01 integration: AndromedaAtmosphere.usf includes this
// file and delegates the buried-observer test to
// ZephyrIsBuriedObserver (mathematically identical to the
// previous inline test). The remaining domain helpers are the
// API consumed from ZEPHYR-02 (surface -> space continuity).
// =========================================================

#ifndef ANDROMEDA_ZEPHYR_SKY_USH
#define ANDROMEDA_ZEPHYR_SKY_USH

// =========================================================
// SKY RANGE FACTOR (must match FAndromedaZephyrManager)
// =========================================================
// 0.85: the inner 85% of the ATMOS shell is the Zephyr sky
// domain; the outer 15% is the continuous ATMOS transition
// band. Strictly < 1, so the outer radius below is strictly
// inside AtmosphereRadius for ANY planet configuration,
// including very thin atmospheres (relative measure adapts
// automatically).
#define ZEPHYR_SKY_RANGE_FACTOR 0.85f

// =========================================================
// SKY RANGE
// =========================================================

// Shell thickness. Guards degenerate input (never negative).
float ZephyrComputeSkyHeight(
    float SurfaceRadius,
    float AtmosphereRadius
)
{
    return max(AtmosphereRadius - SurfaceRadius, 0.0f);
}

// Zephyr sky domain outer radius.
// INVARIANT: result <= AtmosphereRadius (min clamp).
float ZephyrComputeSkyOuterRadius(
    float SurfaceRadius,
    float AtmosphereRadius
)
{
    float SkyHeight = ZephyrComputeSkyHeight(
        SurfaceRadius,
        AtmosphereRadius
    );

    if (!(SurfaceRadius > 0.0f) || !(SkyHeight > 0.0f))
    {
        return SurfaceRadius;
    }

    return min(
        SurfaceRadius + SkyHeight * ZEPHYR_SKY_RANGE_FACTOR,
        AtmosphereRadius
    );
}

// =========================================================
// PLANET-CENTERED ALTITUDE
// =========================================================
// Altitude above the physical surface from the REAL planet
// center. Never camera distance, never world Y, never world
// origin. Rotation/orbit invariant by construction.
float ZephyrAltitude(
    float3 WorldPosition,
    float3 PlanetCenter,
    float SurfaceRadius
)
{
    return length(WorldPosition - PlanetCenter) - SurfaceRadius;
}

// =========================================================
// BURIED OBSERVER
// =========================================================
// True when the camera sits strictly inside the planet body:
// every direction hits rock, no sky segment exists.
// Exact formula previously inlined in AndromedaAtmosphere.usf
// (ATMOS-11 ground-sky guard), now owned by ZEPHYR.
bool ZephyrIsBuriedObserver(
    float CameraDistFromCenter,
    float SurfaceRadius
)
{
    return CameraDistFromCenter < SurfaceRadius * (1.0f - 1e-4f);
}

// =========================================================
// SKY-DOMAIN COORDINATE
// =========================================================
// Normalized altitude inside the Zephyr sky domain:
// 0 at the surface, 1 at ZephyrSkyOuterRadius (clamped).
float ZephyrSkyAltitude01(
    float DistFromCenter,
    float SurfaceRadius,
    float SkyOuterRadius
)
{
    float Denom = SkyOuterRadius - SurfaceRadius;

    if (!(Denom > 0.0f))
    {
        return 0.0f;
    }

    return clamp(
        (DistFromCenter - SurfaceRadius) / Denom,
        0.0f,
        1.0f
    );
}

// =========================================================
// CONTINUOUS SKY WEIGHT (ZEPHYR-02 blending API)
// =========================================================
// 1 at the surface, EXACTLY 0 at the domain boundary, with
// zero derivative at both ends (smoothstep profile): C1
// continuous, so blending sky -> ATMOS outer domain cannot
// introduce any ring, seam or hard boundary.
float ZephyrSkyWeight(float SkyAltitude01)
{
    float x = clamp(SkyAltitude01, 0.0f, 1.0f);
    return 1.0f - x * x * (3.0f - 2.0f * x);
}

// =========================================================
// DOMAIN CLASSIFICATION
// =========================================================
// 0 = below surface, 1 = planetary sky (Zephyr),
// 2 = outer atmosphere (ATMOS transition band),
// 3 = space. Boundaries are shared exactly (<=), so no gap
// and no overlap can ever classify a point twice.
int ZephyrClassifyDomain(
    float DistFromCenter,
    float SurfaceRadius,
    float SkyOuterRadius,
    float AtmosphereRadius
)
{
    if (DistFromCenter < SurfaceRadius)
    {
        return 0;
    }

    if (DistFromCenter <= SkyOuterRadius)
    {
        return 1;
    }

    if (DistFromCenter <= AtmosphereRadius)
    {
        return 2;
    }

    return 3;
}

#endif // ANDROMEDA_ZEPHYR_SKY_USH
