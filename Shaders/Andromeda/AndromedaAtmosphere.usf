// =========================================================
// ANDROMEDA ATMOSPHERE SYSTEM
// =========================================================
//
// ATMOS-04 - Diagnostic Ray Marching:
//     Reconstructs the camera ray per pixel, intersects every
//     atmosphere sphere, marches fixed samples entry->exit and
//     accumulates a stable normalized diagnostic density.

//
// Virtual path : /Andromeda/AndromedaAtmosphere.usf
//                ([Project]/Shaders/Andromeda/AndromedaAtmosphere.usf)
// Entry point  : AndromedaAtmosphereMainPS
//                (registered in AndromedaAtmosphereRenderer.cpp)
//
// Output: fullscreen composite (scene + marched diagnostic).
//
// No physical scattering here. Density is diagnostic only.
//
// The global variables below are bound by name to
// FAndromedaAtmospherePS::FParameters (AndromedaAtmosphereShader.h).

#include "/Engine/Public/Platform.ush"


// =========================================================
// GPU ATMOSPHERE DATA STRUCT
// =========================================================
// Must match FAndromedaAtmosphereGPUData in AndromedaAtmosphereTypes.h.
struct FAndromedaAtmosphereGPUData
{
    float CenterX;          // world center X (cm)
    float CenterY;          // world center Y (cm)
    float SurfaceRadius;    // planet surface radius (cm)
    float CenterZ;          // world center Z (cm)
    float AtmosphereRadius; // atmosphere outer radius (cm)
    float Pad0;             // reserved
    float Pad1;             // reserved
    float Pad2;             // reserved
};


// =========================================================
// SHADER PARAMETERS (bound by name)
// =========================================================

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
int2 ViewportSize;

float3 CameraWorldPosition;
float4x4 InvViewProjection;

int AtmosphereCount;
StructuredBuffer<FAndromedaAtmosphereGPUData> AtmosphereBuffer;


// ATMOS-04 CONSTANTS
// Fixed diagnostic sample count: constant loop, no dynamic cost.
#define ATMOS_MARCH_STEPS 16


// =========================================================
// RAY / SPHERE INTERSECTION
// =========================================================
// Same roots as |O + tD - C|^2 = R^2 with V = C - O:
//   t = dot(V,D) +/- sqrt(dot(V,D)^2 - (|V|^2 - R^2)), t0 <= t1.
// Miss: both < 0. Bn/Cn divide once by R (unit-sphere form) so the
// discriminant is O(1) instead of O(d^2). Identical t in exact arithmetic.

float2 RaySphereIntersect(
    float3 RayOrigin,
    float3 RayDir,
    float3 SphereCenter,
    float SphereRadius
)
{
    // Exact-same-roots stabilization: solve with V = C - O so that
    //   t = dot(V,D) +/- sqrt(dot(V,D)^2 - (|V|^2 - R^2)),
    // then normalize ONCE by R (unit-sphere form). The discriminant is
    // O(1) instead of O(d^2); dropout branch unchanged (t0 <= t1).
    if (!(SphereRadius > 0.0f))
    {
        return float2(-1.0f, -1.0f);
    }

    float3 V = SphereCenter - RayOrigin;
    float B = dot(V, RayDir);
    float C = dot(V, V) - SphereRadius * SphereRadius;

    // Single normalization AFTER the dot products: B/R, C/R^2.
    float InvR = 1.0f / SphereRadius;
    float Bn = B * InvR;
    float Cn = C * (InvR * InvR);

    float Discriminant = Bn * Bn - Cn;

    if (Discriminant < 0.0f)
    {
        return float2(-1.0f, -1.0f);
    }

    float SqrtD = sqrt(Discriminant);
    float T0 = (Bn - SqrtD) * SphereRadius;
    float T1 = (Bn + SqrtD) * SphereRadius;

    return float2(T0, T1);
}


// Normalized height h: 0 surface, 1 outer limit. Density: 1 -> 0.
float DiagnosticDensity(float DistFromCenter, float SurfaceRadius, float AtmosphereRadius)
{
    float Shell = max(AtmosphereRadius - SurfaceRadius, 1.0f);
    float H = saturate((DistFromCenter - SurfaceRadius) / Shell);
    return 1.0f - H;
}

void AndromedaAtmosphereMainPS(
    in float4 SvPosition : SV_Position,
    out float4 OutColor : SV_Target0
)
{
    // Normalized viewport position (SvPosition is viewport-relative).
    float2 UV = SvPosition.xy / max(float2(ViewportSize), float2(1.0f, 1.0f));

    // --------------------------------------------------------
    // Ray reconstruction: EXACT baseline direction, camera-relative form.
    //
    // Baseline (correct visuals, float-unstable at distance):
    //   P_h = mul(Clip, M);  P = P_h.xyz / P_h.w;
    //   RayVec = P - Cam;    RayDir = normalize(RayVec).
    //
    // Identity (exact arithmetic, W = P_h.w):
    //   P - Cam = (P_h.xyz - Cam * W) / W = Num / W.
    // normalize() is invariant to the positive scale 1/W (W > 0 enforced
    // below), so normalize(P - Cam) == normalize(Num).
    //
    // Num is the ONLY large-large subtraction. It arrives here already
    // distributed per-row from the CPU in double precision (see Renderer
    // Step 4: each uploaded row stores Ri - Cam*Wi). The GPU only
    // combines small camera-relative rows and divides once by W.
    // Translation is folded in exactly, never zeroed. No W == 1
    // assumption, no dropped perspective divide, no normalize(clip*R).
    // --------------------------------------------------------
    float4 ClipPos = float4(
        UV.x * 2.0f - 1.0f,
        1.0f - UV.y * 2.0f,
        1.0f,
        1.0f
    );

    // Full rows of the uploaded matrix: xyz are camera-relative
    // (Ri - Cam*Wi, precomputed in double on CPU), w-column untouched.
    float3 Row0 = float3(InvViewProjection[0][0], InvViewProjection[0][1], InvViewProjection[0][2]);
    float3 Row1 = float3(InvViewProjection[1][0], InvViewProjection[1][1], InvViewProjection[1][2]);
    float3 Row2 = float3(InvViewProjection[2][0], InvViewProjection[2][1], InvViewProjection[2][2]);
    float3 Row3 = float3(InvViewProjection[3][0], InvViewProjection[3][1], InvViewProjection[3][2]);
    float W0 = InvViewProjection[0][3];
    float W1 = InvViewProjection[1][3];
    float W2 = InvViewProjection[2][3];
    float W3 = InvViewProjection[3][3];

    // Homogeneous w of P_h (identical to the baseline's P_h.w).
    float W = ClipPos.x * W0 + ClipPos.y * W1 + ClipPos.z * W2 + ClipPos.w * W3;
    if (!(W > 1e-6f) || !isfinite(W))
    {
        OutColor = float4(SceneColorTexture.Sample(SceneColorSampler, UV).rgb, 1.0f);
        return;
    }

    // Num = P_h.xyz - Cam*W, assembled from small relative rows.
    // Identical to the baseline numerator in exact arithmetic; the only
    // large-large subtraction happened in double on the CPU.
    float3 Num = ClipPos.x * Row0 + ClipPos.y * Row1
        + ClipPos.z * Row2 + ClipPos.w * Row3;
    // Same perspective divide as the baseline (W > 0 enforced above).
    float3 RayVec = Num / W;
    float RayLen = length(RayVec);
    if (!(RayLen > 0.0f) || !isfinite(RayLen) || !isfinite(dot(RayVec, float3(1.0f, 1.0f, 1.0f))))
    {
        OutColor = float4(SceneColorTexture.Sample(SceneColorSampler, UV).rgb, 1.0f);
        return;
    }
    float3 RayDir = RayVec / RayLen;

    // Camera-relative frame: the CPU uploads RelCenter = Center - Camera
    // (subtracted in double) into CenterX/Y/Z (see Renderer). The shader
    // ray origin is therefore exactly 0; no world positions remain.
    float3 RayOrigin = float3(0.0f, 0.0f, 0.0f);

    // --------------------------------------------------------
    // Sample scene color.
    // --------------------------------------------------------
    float3 SceneColor = SceneColorTexture.Sample(SceneColorSampler, UV).rgb;

    // --------------------------------------------------------
    // Per atmosphere: intersect, clamp [entry, exit], march, accumulate.
    // --------------------------------------------------------
    float3 AccumulatedDiag = float3(0.0f, 0.0f, 0.0f);

    for (int i = 0; i < AtmosphereCount; ++i)
    {
        FAndromedaAtmosphereGPUData Atm = AtmosphereBuffer[i];

        // RelCenter (center - camera, CPU double) is uploaded in CenterX/Y/Z.
        float3 RelCenter = float3(Atm.CenterX, Atm.CenterY, Atm.CenterZ);
        float SurfaceRadius = Atm.SurfaceRadius;
        float AtmRadius = Atm.AtmosphereRadius;

        float2 TAtm = RaySphereIntersect(RayOrigin, RayDir, RelCenter, AtmRadius);

        if (TAtm.x < 0.0f && TAtm.y < 0.0f)
        {
            // No intersection with this atmosphere.
            continue;
        }

        // The entry point is the nearest non-negative t.
        // If the camera is inside the atmosphere, TAtm.x < 0 and TAtm.y > 0:
        // we treat the camera position as the entry point (t = 0).
        float EntryT = (TAtm.x >= 0.0f) ? TAtm.x : 0.0f;
        float ExitT = TAtm.y;

        // Clamp march interval at the planet surface (no march behind it).
        float2 TSurf = RaySphereIntersect(RayOrigin, RayDir, RelCenter, SurfaceRadius);
        if (TSurf.x >= 0.0f)
        {
            ExitT = min(ExitT, TSurf.x);
        }
        else if (TSurf.y >= 0.0f && TAtm.x < 0.0f)
        {
            continue;
        }

        if (!(ExitT > EntryT))
        {
            continue;
        }

        float MarchLen = ExitT - EntryT;
        if (!(MarchLen > 0.0f) || !(MarchLen < 1e10f))
        {
            continue;
        }

        // Fixed-step march between entry and exit.
        float StepLen = MarchLen / (float)ATMOS_MARCH_STEPS;
        float DensitySum = 0.0f;

        for (int s = 0; s < ATMOS_MARCH_STEPS; ++s)
        {
            float T = EntryT + StepLen * ((float)s + 0.5f);
            // Camera-relative sample: (O + D*T) - C with O = 0 gives
            // D*T - RelCenter. Same distance as the original
            // length((Camera + D*T) - Center) in exact arithmetic, with
            // no large-near-equal subtraction.
            float DistFromCenter = length(RayDir * T - RelCenter);
            DensitySum += DiagnosticDensity(DistFromCenter, SurfaceRadius, AtmRadius);
        }

        // Average density in [0,1] times the normalized chord thickness:
        // rays through the limb cross less volume than central rays, so the
        // diagnostic shows a coherent falloff toward the atmosphere edge.
        float AvgDensity = DensitySum / (float)ATMOS_MARCH_STEPS;
        float ChordFactor = saturate(MarchLen / max(AtmRadius, 1.0f));
        float MarchIntensity = saturate(AvgDensity * ChordFactor);

        // Diagnostic ramp: deep blue -> cyan, brightness proportional to
        // the marched volume. Slight per-atmosphere tint so N atmospheres
        // remain distinguishable without hardcoding planet 0.
        float AtmPhase = (float)i * 0.37f;
        float3 TintA = float3(0.04f, 0.22f, 0.55f);
        float3 TintB = float3(0.15f, 0.75f, 1.00f);
        float3 MarchColor = lerp(TintA, TintB, saturate(AvgDensity + AtmPhase * 0.15f));

        AccumulatedDiag += MarchColor * MarchIntensity;
    }

    // Fullscreen additive composite over the scene color.
    // Intensity > 0 proves entry->samples->exit really marched.
    OutColor = float4(SceneColor + AccumulatedDiag, 1.0f);
}

