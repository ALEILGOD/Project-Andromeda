// =========================================================
// ANDROMEDA ATMOSPHERE SYSTEM
// =========================================================
//
// ATMOS-04 - Diagnostic Ray Marching:
//     Reconstructs the camera ray per pixel, intersects every
//     atmosphere sphere, marches fixed samples entry->exit and
//     accumulates a stable normalized diagnostic density.

//
// Virtual path : /Andromeda/AndromedaAtmosphere.usf
//                ([Project]/Shaders/Andromeda/AndromedaAtmosphere.usf)
// Entry point  : AndromedaAtmosphereMainPS
//                (registered in AndromedaAtmosphereRenderer.cpp)
//
// Output: fullscreen composite (scene + marched diagnostic).
//
// No physical scattering here. Density is diagnostic only.
//
// The global variables below are bound by name to
// FAndromedaAtmospherePS::FParameters (AndromedaAtmosphereShader.h).

#include "/Engine/Public/Platform.ush"


// =========================================================
// GPU ATMOSPHERE DATA STRUCT
// =========================================================
// Must match FAndromedaAtmosphereGPUData in AndromedaAtmosphereTypes.h.
struct FAndromedaAtmosphereGPUData
{
    float CenterX;          // world center X (cm)
    float CenterY;          // world center Y (cm)
    float SurfaceRadius;    // planet surface radius (cm)
    float CenterZ;          // world center Z (cm)
    float AtmosphereRadius; // atmosphere outer radius (cm)
    float Pad0;             // reserved
    float Pad1;             // reserved
    float Pad2;             // reserved
};


// =========================================================
// SHADER PARAMETERS (bound by name)
// =========================================================

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
int2 ViewportSize;

float3 CameraWorldPosition;
float4x4 InvViewProjection;

int AtmosphereCount;
StructuredBuffer<FAndromedaAtmosphereGPUData> AtmosphereBuffer;


// ATMOS-04 CONSTANTS
// Fixed diagnostic sample count: constant loop, no dynamic cost.
#define ATMOS_MARCH_STEPS 16


// =========================================================
// RAY / SPHERE INTERSECTION
// =========================================================
// Returns (t0, t1) with t0 <= t1. Miss (or degenerate ray): both < 0.

float2 RaySphereIntersect(
    float3 RayOrigin,
    float3 RayDir,
    float3 SphereCenter,
    float SphereRadius
)
{
    float3 OC = RayOrigin - SphereCenter;

    float A = dot(RayDir, RayDir);
    float B = 2.0f * dot(OC, RayDir);
    float C = dot(OC, OC) - SphereRadius * SphereRadius;

    float Discriminant = B * B - 4.0f * A * C;

    if (Discriminant < 0.0f)
    {
        return float2(-1.0f, -1.0f);
    }

    float SqrtD = sqrt(Discriminant);
    float Inv2A = 1.0f / (2.0f * A);
    float T0 = (-B - SqrtD) * Inv2A;
    float T1 = (-B + SqrtD) * Inv2A;

    return float2(T0, T1);
}


// Normalized height h: 0 surface, 1 outer limit. Density: 1 -> 0.
float DiagnosticDensity(float DistFromCenter, float SurfaceRadius, float AtmosphereRadius)
{
    float Shell = max(AtmosphereRadius - SurfaceRadius, 1.0f);
    float H = saturate((DistFromCenter - SurfaceRadius) / Shell);
    return 1.0f - H;
}

void AndromedaAtmosphereMainPS(
    in float4 SvPosition : SV_Position,
    out float4 OutColor : SV_Target0
)
{
    // Normalized viewport position (SvPosition is viewport-relative).
    float2 UV = SvPosition.xy / max(float2(ViewportSize), float2(1.0f, 1.0f));

    // --------------------------------------------------------
    // Reconstruct the view ray for this pixel.
    // Clip space: x in [-1,1] (left->right), y in [1,-1] (top->bottom, UE flip).
    // --------------------------------------------------------
    float4 ClipPos = float4(
        UV.x * 2.0f - 1.0f,
        1.0f - UV.y * 2.0f,
        1.0f,
        1.0f
    );

    float4 WorldPos = mul(ClipPos, InvViewProjection);
    WorldPos /= max(WorldPos.w, 1e-6f);

    float3 RayVec = WorldPos.xyz - CameraWorldPosition;
    float3 RayDir = RayVec / max(length(RayVec), 1e-6f);

    // --------------------------------------------------------
    // Sample scene color.
    // --------------------------------------------------------
    float3 SceneColor = SceneColorTexture.Sample(SceneColorSampler, UV).rgb;

    // --------------------------------------------------------
    // Per atmosphere: intersect, clamp [entry, exit], march, accumulate.
    // --------------------------------------------------------
    float3 AccumulatedDiag = float3(0.0f, 0.0f, 0.0f);

    for (int i = 0; i < AtmosphereCount; ++i)
    {
        FAndromedaAtmosphereGPUData Atm = AtmosphereBuffer[i];

        float3 AtmCenter = float3(Atm.CenterX, Atm.CenterY, Atm.CenterZ);
        float SurfaceRadius = Atm.SurfaceRadius;
        float AtmRadius = Atm.AtmosphereRadius;

        float2 TAtm = RaySphereIntersect(CameraWorldPosition, RayDir, AtmCenter, AtmRadius);

        if (TAtm.x < 0.0f && TAtm.y < 0.0f)
        {
            // No intersection with this atmosphere.
            continue;
        }

        // The entry point is the nearest non-negative t.
        // If the camera is inside the atmosphere, TAtm.x < 0 and TAtm.y > 0:
        // we treat the camera position as the entry point (t = 0).
        float EntryT = (TAtm.x >= 0.0f) ? TAtm.x : 0.0f;
        float ExitT = TAtm.y;

        // Clamp march interval at the planet surface (no march behind it).
        float2 TSurf = RaySphereIntersect(CameraWorldPosition, RayDir, AtmCenter, SurfaceRadius);
        if (TSurf.x >= 0.0f)
        {
            ExitT = min(ExitT, TSurf.x);
        }
        else if (TSurf.y >= 0.0f && TAtm.x < 0.0f)
        {
            continue;
        }

        if (!(ExitT > EntryT))
        {
            continue;
        }

        float MarchLen = ExitT - EntryT;
        if (!(MarchLen > 0.0f) || !(MarchLen < 1e10f))
        {
            continue;
        }

        // Fixed-step march between entry and exit.
        float StepLen = MarchLen / (float)ATMOS_MARCH_STEPS;
        float DensitySum = 0.0f;

        for (int s = 0; s < ATMOS_MARCH_STEPS; ++s)
        {
            float T = EntryT + StepLen * ((float)s + 0.5f);
            float3 SamplePos = CameraWorldPosition + RayDir * T;
            float DistFromCenter = length(SamplePos - AtmCenter);
            DensitySum += DiagnosticDensity(DistFromCenter, SurfaceRadius, AtmRadius);
        }

        // Average density in [0,1] times the normalized chord thickness:
        // rays through the limb cross less volume than central rays, so the
        // diagnostic shows a coherent falloff toward the atmosphere edge.
        float AvgDensity = DensitySum / (float)ATMOS_MARCH_STEPS;
        float ChordFactor = saturate(MarchLen / max(AtmRadius, 1.0f));
        float MarchIntensity = saturate(AvgDensity * ChordFactor);

        // Diagnostic ramp: deep blue -> cyan, brightness proportional to
        // the marched volume. Slight per-atmosphere tint so N atmospheres
        // remain distinguishable without hardcoding planet 0.
        float AtmPhase = (float)i * 0.37f;
        float3 TintA = float3(0.04f, 0.22f, 0.55f);
        float3 TintB = float3(0.15f, 0.75f, 1.00f);
        float3 MarchColor = lerp(TintA, TintB, saturate(AvgDensity + AtmPhase * 0.15f));

        AccumulatedDiag += MarchColor * MarchIntensity;
    }

    // Fullscreen additive composite over the scene color.
    // Intensity > 0 proves entry->samples->exit really marched.
    OutColor = float4(SceneColor + AccumulatedDiag, 1.0f);
}

