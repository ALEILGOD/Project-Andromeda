// =========================================================
// ANDROMEDA ATMOSPHERE SYSTEM
// =========================================================
//
// ATMOS-02 - Fullscreen diagnostic shader dispatched through a real
// RDG pass in the post-processing chain (after the tonemapper).
//
// Virtual path : /Andromeda/AndromedaAtmosphere.usf
//                ([Project]/Shaders/Andromeda/AndromedaAtmosphere.usf)
// Entry point  : AndromedaAtmosphereMainPS
//                (registered in AndromedaAtmosphereRenderer.cpp)
//
// Output is a diagnostic split view, generated entirely by this shader:
//     left  half : input scene color (proves SceneColor in -> Pass -> out)
//     right half : procedural gradient + grid (proves GPU dispatch)
//
// No atmosphere physics here: ray marching, Rayleigh, Mie, absorption,
// optical depth and transmittance arrive in ATMOS-04+.
//
// The global variables below are bound by name to
// FAndromedaAtmospherePS::FParameters (AndromedaAtmosphereShader.h).

#include "/Engine/Public/Platform.ush"

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
int2 ViewportSize;

void AndromedaAtmosphereMainPS(
    in float4 SvPosition : SV_Position,
    out float4 OutColor : SV_Target0
)
{
    // Normalized viewport position (SvPosition is viewport-relative).
    float2 UV = SvPosition.xy / max(float2(ViewportSize), float2(1.0f, 1.0f));

    // [Right half] Procedural diagnostic pattern: magenta->cyan vertical
    // gradient with a 32px white grid. Unmistakably generated by this shader.
    float3 Gradient = lerp(float3(1.0f, 0.0f, 1.0f), float3(0.0f, 1.0f, 1.0f), UV.y);
    float2 GridCoord = abs(frac(SvPosition.xy / float2(32.0f, 32.0f)) - 0.5f);
    float GridLine = step(min(GridCoord.x, GridCoord.y), 0.05f);
    float3 Pattern = lerp(Gradient * 0.6f, float3(1.0f, 1.0f, 1.0f), GridLine);

    // [Left half] Input scene color, sampled from the previous post-process
    // stage (proves the SceneColor -> pass -> output chain).
    float3 SceneColor = SceneColorTexture.Sample(SceneColorSampler, UV).rgb;

    float3 Diagnostic = (UV.x < 0.5f) ? SceneColor : Pattern;

    // Thin white border: confirms full-viewport coverage of the pass.
    float Border = (UV.x < 0.004f || UV.x > 0.996f || UV.y < 0.004f || UV.y > 0.996f) ? 1.0f : 0.0f;
    Diagnostic = lerp(Diagnostic, float3(1.0f, 1.0f, 1.0f), Border);

    OutColor = float4(Diagnostic, 1.0f);
}