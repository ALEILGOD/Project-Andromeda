// =========================================================
// ANDROMEDA ATMOSPHERE SYSTEM
// =========================================================
//
// ATMOS-04 - Diagnostic Ray Marching:
//     Reconstructs the camera ray per pixel, intersects every
//     atmosphere sphere, marches fixed samples entry->exit and
//     accumulates a stable normalized diagnostic density.
//
// ATMOS-05 - Finite Point-Star Transport:
//     The star is a finite-position point source. Its position is
//     supplied in the same camera-relative frame as the atmosphere.
//     For every ray-march sample we calculate:
//
//         Sample -> Star
//
//     and use the local planet-surface normal to determine:
//
//         Day / Terminator / Night
//
// ATMOS-06 - Rayleigh Scattering:
//     First-order Rayleigh scattering with exponential density profile
//     and standard (1 + cos^2) phase function. Uses wavelength-dependent
//     RayleighScattering coefficient and RayleighScaleHeight from
//     atmosphere parameters. Preserves ATMOS-05 finite point-star
//     transport and ATMOS-04 numerical stabilization.
//
// No Mie scattering, absorption, optical depth, transmittance or
// inverse-square luminosity model is implemented here.
// Those belong to later atmosphere milestones.
//
// Virtual path:
//     /Andromeda/AndromedaAtmosphere.usf
//
// Entry point:
//     AndromedaAtmosphereMainPS
//
// =========================================================

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"

// =========================================================
// GPU ATMOSPHERE DATA STRUCT
// =========================================================
//
// MUST match FAndromedaAtmosphereGPUData in
// AndromedaAtmosphereTypes.h exactly.
//
// All position values are camera-relative.
//
// Center:
//     AtmosphereCenterWorld - CameraWorldPosition
//
// Star:
//     StarWorldPosition - CameraWorldPosition
//
// Because the shader ray origin is zero, these values can be
// directly combined with camera-relative sample positions.
//

struct FAndromedaAtmosphereGPUData
{
    float CenterX;
    float CenterY;
    float SurfaceRadius;

    float CenterZ;
    float AtmosphereRadius;

    float Pad0;
    float Pad1;
    float Pad2;

    // ATMOS-05:
    // Finite point-star position, camera-relative.
    float StarPositionX;
    float StarPositionY;
    float StarPositionZ;

    // ATMOS-06: Rayleigh scattering parameters
    float RayleighScatteringX;
    float RayleighScatteringY;
    float RayleighScatteringZ;
    float RayleighScaleHeight;

    // Padding for 16-float (64-byte) structured buffer alignment
    float Pad3;
    float Pad4;
    float Pad5;
};

// =========================================================
// SHADER PARAMETERS
// =========================================================

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;

int2 ViewportSize;

float3 CameraWorldPosition;
float4x4 InvViewProjection;

int AtmosphereCount;

StructuredBuffer<FAndromedaAtmosphereGPUData> AtmosphereBuffer;

// ATMOS-04 DEPTH OCCLUSION
int DepthOcclusionEnabled;

// =========================================================
// ATMOS-04 CONSTANTS
// =========================================================

#define ATMOS_MARCH_STEPS 16

#define ATMOS_LIGHT_MARCH_STEPS 8


// =========================================================
// RAY / SPHERE INTERSECTION
// =========================================================
//
// Same roots as:
//
//     |O + tD - C|² = R²
//
// with:
//
//     V = C - O
//
//     t = dot(V,D) +/- sqrt(dot(V,D)^2 - (|V|² - R²))
//
// The discriminant is normalized by R before evaluation to keep
// its magnitude near O(1), avoiding precision loss at huge
// world distances.
//
// THIS FUNCTION IS ATMOS-04 STABILIZATION AND MUST NOT BE
// REPLACED WITH THE ORIGINAL UNNORMALIZED FORM.
//

float2 RaySphereIntersect(
    float3 RayOrigin,
    float3 RayDir,
    float3 SphereCenter,
    float SphereRadius
)
{
    if (!(SphereRadius > 0.0f))
    {
        return float2(-1.0f, -1.0f);
    }

    float3 V = SphereCenter - RayOrigin;

    float B = dot(V, RayDir);

    float C =
        dot(V, V) -
        SphereRadius * SphereRadius;

    // Single normalization AFTER the dot products.
    float InvR =
        1.0f / SphereRadius;

    float Bn =
        B * InvR;

    float Cn =
        C * (InvR * InvR);

    float Discriminant =
        Bn * Bn -
        Cn;

    if (Discriminant < 0.0f)
    {
        return float2(-1.0f, -1.0f);
    }

    float SqrtD =
        sqrt(Discriminant);

    float T0 =
        (Bn - SqrtD) *
        SphereRadius;

    float T1 =
        (Bn + SqrtD) *
        SphereRadius;

    return float2(T0, T1);
}


// =========================================================
// ATMOS-06 RAYLEIGH DENSITY
// =========================================================
//
// Exponential density profile based on altitude above surface:
//     density = exp(-altitude / RayleighScaleHeight)
//
// Altitude is derived from distance to atmosphere center minus surface radius.
// Clamped to valid range [0, AtmosphereRadius - SurfaceRadius].
// Normalized to 1 at surface for consistent scaling with RayleighScattering coefficient.

float RayleighDensity(
    float DistFromCenter,
    float SurfaceRadius,
    float AtmosphereRadius,
    float RayleighScaleHeight
)
{
    float Altitude =
        DistFromCenter - SurfaceRadius;

    float ShellThickness =
        max(
            AtmosphereRadius - SurfaceRadius,
            1.0f
        );

    // Clamp altitude to valid atmospheric shell
    Altitude = clamp(Altitude, 0.0f, ShellThickness);

    // Exponential density falloff
    // At surface (altitude=0): density = 1.0
    // At top of atmosphere: density = exp(-ShellThickness / RayleighScaleHeight)
    return exp(-Altitude / max(RayleighScaleHeight, 1.0f));
}


// =========================================================
// ATMOS-06 RAYLEIGH PHASE FUNCTION
// =========================================================
//
// Standard Rayleigh phase function:
//     P_R(theta) = 3 / (16*pi) * (1 + cos^2(theta))
//
// where cos(theta) = dot(ViewDir, LightDir)
// ViewDir points from sample to camera (normalized, opposite of RayDir)
// LightDir points from sample to star (normalized)
//
// The 3/(16*pi) normalization constant is folded into the RayleighScattering
// coefficient, so we return just (1 + cos^2(theta)).

float RayleighPhase(
    float3 ViewDir,
    float3 LightDir
)
{
    float CosTheta = dot(ViewDir, LightDir);
    float CosThetaSq = CosTheta * CosTheta;
    return 1.0f + CosThetaSq;
}


// =========================================================
// ATMOS-08 STAR TRANSMITTANCE
// =========================================================
//
// Computes the transmittance of stellar light along the path
// from the scattering sample to the star, through the atmosphere.
//
// The light ray is parameterized from the sample toward the star:
//
//     LightRayOrigin = SamplePos
//     LightRayDir = SampleToStarDirection
//
// The ray is integrated from the sample (inside atmosphere) outward
// to the atmosphere boundary, with planet-surface occlusion.
//
// All distances are in camera-relative centimeters.
// RayleighScattering is on a km^-1 scale, so step length is
// converted to km before multiplication.
//
// Returns RGB transmittance (wavelength-dependent).
// =========================================================

float3 ComputeStarTransmittance(
    float3 SamplePos,
    float3 SampleToStarDirection,
    float3 RelCenter,
    float SurfaceRadius,
    float AtmosphereRadius,
    float RayleighScaleHeight,
    float3 RayleighScattering
)
{
    // Light ray: STAR -> SAMPLE (sample is inside atmosphere)
    float3 LightRayOrigin = SamplePos;
    float3 LightRayDir = SampleToStarDirection;

    // Intersect light ray with atmosphere outer boundary
    float2 TLightAtm = RaySphereIntersect(
        LightRayOrigin,
        LightRayDir,
        RelCenter,
        AtmosphereRadius
    );

    // No atmosphere intersection on light path
    if (TLightAtm.x < 0.0f && TLightAtm.y < 0.0f)
    {
        return float3(1.0f, 1.0f, 1.0f);
    }

    // Sample is inside atmosphere: entry is at 0, exit is at TLightAtm.y
    float LightEntryT = max(TLightAtm.x, 0.0f);
    float LightExitT = TLightAtm.y;

    // Check planet surface occlusion on light path
    float2 TLightSurf = RaySphereIntersect(
        LightRayOrigin,
        LightRayDir,
        RelCenter,
        SurfaceRadius
    );

    // Only clamp if ray genuinely penetrates planetary surface
    // (two distinct intersections with positive interval)
    if (TLightSurf.x >= 0.0f && TLightSurf.y > TLightSurf.x + 1e-4f)
    {
        LightExitT = min(LightExitT, TLightSurf.x);
    }

    // Invalid or zero-length light path
    if (!(LightExitT > LightEntryT))
    {
        return float3(1.0f, 1.0f, 1.0f);
    }

    // Fixed-step integration over light path
    const float CentimetersToKilometers = 0.00001f;
    float LightStepLen = (LightExitT - LightEntryT) / (float)ATMOS_LIGHT_MARCH_STEPS;
    float LightStepLenKm = LightStepLen * CentimetersToKilometers;

    float3 OpticalDepth = float3(0.0f, 0.0f, 0.0f);

    for (int ls = 0; ls < ATMOS_LIGHT_MARCH_STEPS; ++ls)
    {
        float t = LightEntryT + LightStepLen * ((float)ls + 0.5f);
        float3 LightSamplePos = LightRayOrigin + LightRayDir * t;

        float DistFromCenter = length(LightSamplePos - RelCenter);

        float Density = RayleighDensity(
            DistFromCenter,
            SurfaceRadius,
            AtmosphereRadius,
            RayleighScaleHeight
        );

        // Extinction = Density * ScatteringCoefficient (per km)
        OpticalDepth += Density * RayleighScattering * LightStepLenKm;
    }

    // Transmittance = exp(-OpticalDepth), RGB
    float3 Transmittance = exp(-OpticalDepth);

    // Numerical safety
    if (!isfinite(Transmittance.x) || !isfinite(Transmittance.y) || !isfinite(Transmittance.z))
    {
        return float3(1.0f, 1.0f, 1.0f);
    }

    return Transmittance;
}


// =========================================================
// MAIN PIXEL SHADER
// =========================================================

void AndromedaAtmosphereMainPS(
    in float4 SvPosition : SV_Position,
    out float4 OutColor : SV_Target0
)
{
    // =====================================================
    // NORMALIZED VIEWPORT POSITION
    // =====================================================

    float2 UV =
        SvPosition.xy /
        max(
            float2(ViewportSize),
            float2(1.0f, 1.0f)
        );

    // =====================================================
    // ATMOS-04 RAY RECONSTRUCTION
    // =====================================================
    //
    // Baseline:
    //
    //     P_h = mul(Clip, M)
    //     P   = P_h.xyz / P_h.w
    //     Ray  = P - Camera
    //
    // Stable identity:
    //
    //     P - Camera
    //       = (P_h.xyz - Camera * P_h.w) / P_h.w
    //
    // The CPU has already calculated:
    //
    //     Ri - Camera * Wi
    //
    // in double precision.
    //
    // The shader only combines small camera-relative values.
    //
    // THIS IS THE EXACT ATMOS-04 NUMERICAL STABILIZATION.
    // =====================================================

    float4 ClipPos =
        float4(
            UV.x * 2.0f - 1.0f,
            1.0f - UV.y * 2.0f,
            1.0f,
            1.0f
        );

    float3 Row0 =
        float3(
            InvViewProjection[0][0],
            InvViewProjection[0][1],
            InvViewProjection[0][2]
        );

    float3 Row1 =
        float3(
            InvViewProjection[1][0],
            InvViewProjection[1][1],
            InvViewProjection[1][2]
        );

    float3 Row2 =
        float3(
            InvViewProjection[2][0],
            InvViewProjection[2][1],
            InvViewProjection[2][2]
        );

    float3 Row3 =
        float3(
            InvViewProjection[3][0],
            InvViewProjection[3][1],
            InvViewProjection[3][2]
        );

    float W0 =
        InvViewProjection[0][3];

    float W1 =
        InvViewProjection[1][3];

    float W2 =
        InvViewProjection[2][3];

    float W3 =
        InvViewProjection[3][3];

    float W =
        ClipPos.x * W0 +
        ClipPos.y * W1 +
        ClipPos.z * W2 +
        ClipPos.w * W3;

    if (!(W > 1e-6f) || !isfinite(W))
    {
        OutColor =
            float4(
                SceneColorTexture.Sample(
                    SceneColorSampler,
                    UV
                ).rgb,
                1.0f
            );

        return;
    }

    float3 Num =
        ClipPos.x * Row0 +
        ClipPos.y * Row1 +
        ClipPos.z * Row2 +
        ClipPos.w * Row3;

    float3 RayVec =
        Num / W;

    float RayLen =
        length(RayVec);

    if (
        !(RayLen > 0.0f) ||
        !isfinite(RayLen) ||
        !isfinite(
            dot(
                RayVec,
                float3(
                    1.0f,
                    1.0f,
                    1.0f
                )
            )
        )
    )
    {
        OutColor =
            float4(
                SceneColorTexture.Sample(
                    SceneColorSampler,
                    UV
                ).rgb,
                1.0f
            );

        return;
    }

    float3 RayDir =
        RayVec / RayLen;

    // Camera-relative origin.
    float3 RayOrigin =
        float3(
            0.0f,
            0.0f,
            0.0f
        );

    // =====================================================
    // SCENE COLOR
    // =====================================================

    float3 SceneColor =
        SceneColorTexture.Sample(
            SceneColorSampler,
            UV
        ).rgb;

    // =====================================================
    // ATMOS-04 DEPTH OCCLUSION
    // =====================================================

    float SceneDepthDeviceZ =
        1.0f;

    float SceneDepthW =
        0.0f;

    float DepthToRayScale =
        0.0f;

    if (DepthOcclusionEnabled != 0)
    {
        SceneDepthDeviceZ =
            SceneTexturesStruct.SceneDepthTexture.SampleLevel(
                SceneTexturesStruct.PointClampSampler,
                UV,
                0
            ).r;

        SceneDepthW =
            SceneDepthDeviceZ *
                View.InvDeviceZToWorldZTransform[0]
            +
            View.InvDeviceZToWorldZTransform[1]
            +
            1.0f /
            (
                SceneDepthDeviceZ *
                    View.InvDeviceZToWorldZTransform[2]
                -
                View.InvDeviceZToWorldZTransform[3]
            );

        // For every point on the ray:
        //
        //     W(t) = t * dot(RayDir, ViewZ)
        //
        // At the far reconstructed point:
        //
        //     W == RayLen * dot(RayDir, ViewZ)
        //
        // so:
        //
        //     W / RayLen
        //
        // is the per-ray conversion factor.

        DepthToRayScale =
            W / RayLen;
    }

    // =====================================================
    // ATMOSPHERE ACCUMULATION
    // =====================================================

    float3 AccumulatedScattering =
        float3(
            0.0f,
            0.0f,
            0.0f
        );

    for (
        int i = 0;
        i < AtmosphereCount;
        ++i
    )
    {
        FAndromedaAtmosphereGPUData Atm =
            AtmosphereBuffer[i];

        float3 RelCenter =
            float3(
                Atm.CenterX,
                Atm.CenterY,
                Atm.CenterZ
            );

        float SurfaceRadius =
            Atm.SurfaceRadius;

        float AtmRadius =
            Atm.AtmosphereRadius;

        // =================================================
        // ATMOS-04 ATMOSPHERE INTERSECTION
        // =================================================

        float2 TAtm =
            RaySphereIntersect(
                RayOrigin,
                RayDir,
                RelCenter,
                AtmRadius
            );

        if (
            TAtm.x < 0.0f &&
            TAtm.y < 0.0f
        )
        {
            continue;
        }

        // =================================================
        // ATMOS-04 DEPTH OCCLUSION GATE
        // =================================================

        float OcclusionFactor =
            1.0f;

        if (
            DepthOcclusionEnabled != 0 &&
            SceneDepthDeviceZ > 0.0f &&
            SceneDepthDeviceZ < 1.0f &&
            SceneDepthW > 0.0f
        )
        {
            float ExitW =
                TAtm.y *
                DepthToRayScale;

            if (
                ExitW > 0.0f &&
                SceneDepthW <
                    ExitW *
                    (1.0f - 1e-4f)
            )
            {
                OcclusionFactor =
                    0.0f;
            }
        }

        // =================================================
        // ENTRY / EXIT
        // =================================================

        float EntryT =
            (TAtm.x >= 0.0f)
                ? TAtm.x
                : 0.0f;

        float ExitT =
            TAtm.y;

        // Clamp at planet surface.
        float2 TSurf =
            RaySphereIntersect(
                RayOrigin,
                RayDir,
                RelCenter,
                SurfaceRadius
            );

        // Only clamp ExitT when the ray actually penetrates the planetary surface
        // (two distinct surface intersections with a positive interval).
        if (TSurf.x >= 0.0f && TSurf.y > TSurf.x + 1e-4f)
        {
            ExitT = min(ExitT, TSurf.x);
        }
        else if (
            TSurf.y >= 0.0f &&
            TAtm.x < 0.0f
        )
        {
            continue;
        }

        if (!(ExitT > EntryT))
        {
            continue;
        }

        float MarchLen =
            ExitT - EntryT;

        if (
            !(MarchLen > 0.0f) ||
            !(MarchLen < 1e10f)
        )
        {
            continue;
        }

        // =================================================
        // ATMOS-05 FINITE POINT STAR
        // =================================================
        //
        // IMPORTANT:
        //
        // Do NOT calculate a single global star direction.
        //
        // The star is a finite point source, therefore every
        // sample must calculate:
        //
        //     ToStar = StarPosition - SamplePosition
        //
        // Since both are camera-relative, no large world-space
        // subtraction occurs here.
        //
        // StarPosition:
        //
        //     StarWorldPosition - CameraWorldPosition
        //
        // SamplePosition:
        //
        //     Camera-relative ray position
        //
        // Therefore:
        //
        //     ToStar =
        //         (StarWorld - Camera)
        //         -
        //         (SampleWorld - Camera)
        //
        // which is exactly:
        //
        //     StarWorld - SampleWorld
        //
        // in exact arithmetic.
        // =================================================

        float3 StarPosition =
            float3(
                Atm.StarPositionX,
                Atm.StarPositionY,
                Atm.StarPositionZ
            );

        // =================================================
        // FIXED-STEP MARCH
        // =================================================

        float StepLen =
            MarchLen /
            (float)ATMOS_MARCH_STEPS;

        float3 ScatteringSum =
            float3(0.0f, 0.0f, 0.0f);

        for (
            int s = 0;
            s < ATMOS_MARCH_STEPS;
            ++s
        )
        {
            float T =
                EntryT +
                StepLen *
                ((float)s + 0.5f);

            // Camera-relative sample position.
            float3 SamplePos =
                RayDir * T;

            // =================================================
            // ATMOS-04 DENSITY GEOMETRY
            // =================================================

            float DistFromCenter =
                length(
                    SamplePos -
                    RelCenter
                );

            // ATMOS-06: Rayleigh density using exponential profile
            float BaseDensity =
                RayleighDensity(
                    DistFromCenter,
                    SurfaceRadius,
                    AtmRadius,
                    Atm.RayleighScaleHeight
                );

            // =================================================
            // ATMOS-05 SAMPLE -> STAR
            // =================================================

            float3 ToStar =
                StarPosition -
                SamplePos;

            float StarDistanceSq =
                dot(
                    ToStar,
                    ToStar
                );

            float3 SampleToStarDirection =
                float3(
                    0.0f,
                    0.0f,
                    0.0f
                );

            if (StarDistanceSq > 1e-8f)
            {
                SampleToStarDirection =
                    ToStar *
                    rsqrt(StarDistanceSq);
            }

            // =================================================
            // ATMOS-05 LOCAL PLANET NORMAL
            // =================================================
            //
            // The atmosphere is centered on the planet.
            // Using the planet center rather than the camera
            // gives the correct day/night boundary over the
            // spherical body.
            // =================================================

            float3 SurfaceNormal =
                SamplePos -
                RelCenter;

            float SurfaceNormalSq =
                dot(
                    SurfaceNormal,
                    SurfaceNormal
                );

            if (SurfaceNormalSq > 1e-8f)
            {
                SurfaceNormal *=
                    rsqrt(
                        SurfaceNormalSq
                    );
            }
            else
            {
                SurfaceNormal =
                    float3(
                        0.0f,
                        0.0f,
                        1.0f
                    );
            }

            // =================================================
            // DAY / TERMINATOR / NIGHT (ATMOS-05 preserved)
            // =================================================
            //
            // +1:
            //     surface directly faces the star
            //
            //  0:
            //     terminator
            //
            // -1:
            //     surface faces away from the star
            //
            // smoothstep gives a soft terminator rather than
            // a hard binary day/night boundary.
            // =================================================

            float StarFacing =
                dot(
                    SurfaceNormal,
                    SampleToStarDirection
                );

            float DayFactor =
                smoothstep(
                    -0.35f,
                    0.35f,
                    StarFacing
                );

            // ATMOS-05 night floor preserved for terminator transition.
            // Full multiple-scattering night illumination belongs to later milestones.
            float NightFloor =
                0.08f;

            float StarLightContribution =
                lerp(
                    NightFloor,
                    1.0f,
                    DayFactor
                );

            // =================================================
            // ATMOS-08 STAR TRANSMITTANCE
            // =================================================
            //
            // Computes the transmittance of stellar light from the
            // star through the atmosphere to the current scattering
            // sample. This attenuates the stellar light reaching the
            // sample based on Rayleigh optical depth along the
            // STAR -> SAMPLE path.
            //
            // Only computed if we have a valid star direction.
            // =================================================

            float3 Transmittance = float3(1.0f, 1.0f, 1.0f);

            if (StarDistanceSq > 1e-8f)
            {
                Transmittance = ComputeStarTransmittance(
                    SamplePos,
                    SampleToStarDirection,
                    RelCenter,
                    SurfaceRadius,
                    AtmRadius,
                    Atm.RayleighScaleHeight,
                    float3(
                        Atm.RayleighScatteringX,
                        Atm.RayleighScatteringY,
                        Atm.RayleighScatteringZ
                    )
                );
            }

            // =================================================
            // ATMOS-06 RAYLEIGH SCATTERING
            // =================================================
            //
            // View direction is from sample to camera.
            // Since RayOrigin = 0 and RayDir points from camera to sample,
            // the view direction (sample -> camera) is -RayDir.
            //
            // Light direction is from sample to star (SampleToStarDirection).
            //
            // Rayleigh phase function: (1 + cos^2(theta))
            // where cos(theta) = dot(ViewDir, LightDir)
            //
            // Scattering coefficient is wavelength-dependent (RayleighScattering).
            // The 3/(16*pi) normalization is folded into the coefficient.
            // =================================================

            float3 ViewDir = -RayDir;  // sample -> camera
            float Phase = RayleighPhase(ViewDir, SampleToStarDirection);

            // Rayleigh scattering color (wavelength dependent)
            float3 RayleighColor =
                float3(
                    Atm.RayleighScatteringX,
                    Atm.RayleighScatteringY,
                    Atm.RayleighScatteringZ
                );

            // Local scattering contribution:
            //   density * phase * scattering_coefficient * star_illumination * transmittance
            float3 LocalScattering =
                BaseDensity *
                Phase *
                RayleighColor *
                StarLightContribution *
                Transmittance;

            ScatteringSum +=
                LocalScattering;
        }

        // =================================================
        // ATMOS-06: ACCUMULATE RAYLEIGH SCATTERING
        // =================================================
        //
        // Average scattering over march steps, scaled by chord length.
        // The chord factor accounts for the path length through the atmosphere.
        //
        // No diagnostic tint - use the physically computed Rayleigh color.
        // =================================================

        float3 AvgScattering =
            ScatteringSum /
            (float)ATMOS_MARCH_STEPS;

        // MarchLen is in Unreal centimeters.
        // RayleighScattering parameters are expressed on a km^-1 scale.
        const float CentimetersToKilometers = 0.00001f;
        float PathLengthKm = MarchLen * CentimetersToKilometers;

        const float RayleighIntensityScale = 0.75f;

        float3 MarchScattering =
            AvgScattering *
            PathLengthKm *
            OcclusionFactor *
            RayleighIntensityScale;

        AccumulatedScattering +=
            MarchScattering;
    }

    // =====================================================
    // FULLSCREEN ADDITIVE COMPOSITE
    // =====================================================

    OutColor =
        float4(
            SceneColor +
            AccumulatedScattering,
            1.0f
        );
}