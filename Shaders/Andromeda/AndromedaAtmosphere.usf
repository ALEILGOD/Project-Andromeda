// =========================================================
// ANDROMEDA ATMOSPHERE SYSTEM
// =========================================================
//
// ATMOS-04 - Diagnostic Ray Marching:
//     Reconstructs the camera ray per pixel, intersects every
//     atmosphere sphere, marches fixed samples entry->exit and
//     accumulates a stable normalized diagnostic density.
//
// ATMOS-05 - Finite Point-Star Transport:
//     The star is a finite-position point source. Its position is
//     supplied in the same camera-relative frame as the atmosphere.
//     For every ray-march sample we calculate:
//
//         Sample -> Star
//
//     and use the local planet-surface normal to determine:
//
//         Day / Terminator / Night
//
// ATMOS-06 - Rayleigh Scattering:
//     First-order Rayleigh scattering with exponential density profile
//     and standard (1 + cos^2) phase function. Uses wavelength-dependent
//     RayleighScattering coefficient and RayleighScaleHeight from
//     atmosphere parameters. Preserves ATMOS-05 finite point-star
//     transport and ATMOS-04 numerical stabilization.
//
// No Mie scattering, absorption, optical depth, transmittance or
// inverse-square luminosity model is implemented here.
// Those belong to later atmosphere milestones.
//
// ATMOS-10 - Rayleigh Multiple Scattering (Order 2):
//     Every view-march sample P computes, in addition to first-order
//     direct-star scattering L1, a real second-order term L2. L2 is the
//     Rayleigh scattering at P of diffuse light that has ALREADY been
//     scattered once elsewhere in the atmosphere:
//
//         STAR -> Q (direct, T_star) -> scatter at Q (J1)
//              -> transport Q -> P (segment transmittance T_pq)
//              -> scatter at P toward camera (phase) -> CAMERA
//
// The incident diffuse field at P is gathered by marching short
// segments along 4 tetrahedral quadrature directions and, at each
// gathered point Q, evaluating the full first-order source
// (density x Rayleigh coeff x phase x day-gate x star
// transmittance with coarse light march). Nothing is a constant
// multiplier: L2 depends on sample position, local density,
// star direction, gathered radiance, transmittances, Rayleigh
// coefficients and phase functions. Night-side/terminator response
// emerges from geometry + optical depth, no twilight hacks.
//
// ATMOS-11 - Surface Sky / Atmospheric Sky Radiance:
//     Dedicated front-to-back sky path for camera rays that do NOT
//     hit scene geometry (GeometryT does not cut the atmospheric
//     segment). The pre-ATMOS-11 code marched sky rays with the same
//     additive no-extinction volume integral used for geometry rays
//     AND added a second aerial integration over the identical
//     segment (double counting), with no view-path extinction, so
//     zenith/horizon had no physical saturation and the surface sky
//     had no bounded radiance. ATMOS-11 integrates sky rays as:
//
//         L = integral J(s) * T(camera -> s) ds,  J = J1 + J2
//
//     with wavelength-dependent extinction accumulated along the
//     march. Zenith/horizon ratio, sun-forward brightness, sunset
//     reddening and night darkening all emerge from density,
//     Rayleigh phase, star transmittance and optical depth.
//     Geometry rays keep the exact ATMOS-09/10 path untouched.
//
// ATMOS-11 TRUE GROUND SKY (visual-test corrections):
//     The first sky branch alone still rendered "atmosphere from
//     space / gradient" on the surface. Three proven defects fixed:
//     (a) the surface-straddle guard (TSurf.x < 0 <= TSurf.y &&
//     TAtm.x < 0 -> continue) discarded EVERY upward sky ray for an
//     observer standing on the surface, where the surface sphere
//     passes exactly through the ray origin; replaced by a robust
//     buried-observer test on |RelCenter| vs SurfaceRadius;
//     (b) ATMOS_OPTICAL_DEPTH_SCALE 0.008 forced T ~= 1 on all paths,
//     making brightness = sigma * path * phase (a smooth shell);
//     restored to unity so saturation/reddening/terminator contrast
//     emerge - scattering and extinction share one cross-section;
//     (c) ComputeStarTransmittance returned 1 when the planet occults
//     the star (zero-length surface-clamped path); now returns 0.
//
// ATMOS-11 TRUE PLANETARY SKY (unified integrator):
//     Final diagnosis showed geometry-ray segments were integrated
//     TWICE with the identical J1 (aerial x3 + volume x8 over the
//     same [EntryT, ExitT]), i.e. an 11x haze washing distant terrain
//     into sky-colored milk and erasing all horizon contrast. The
//     three ray classes now share ONE front-to-back integrator
//     (ComputeViewRadiance, J1 + J2 with view-path extinction):
//     sky rays -> sky radiance, geometry rays -> aerial in-scatter,
//     space views -> limb radiance. Same atmosphere, same system.
//

//
// Virtual path:
//     /Andromeda/AndromedaAtmosphere.usf
//
// Entry point:
//     AndromedaAtmosphereMainPS
//
// =========================================================

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"

// ZEPHYR-01: planetary-sky domain authority (domain math only;
// transport stays in this file). Resolves via the '/Andromeda'
// virtual shader directory mapping to Shaders/Andromeda.
#include "/Andromeda/Zephyr/AndromedaZephyrSky.ush"

// =========================================================
// GPU ATMOSPHERE DATA STRUCT
// =========================================================
//
// MUST match FAndromedaAtmosphereGPUData in
// AndromedaAtmosphereTypes.h exactly.
//
// All position values are camera-relative.
//
// Center:
//     AtmosphereCenterWorld - CameraWorldPosition
//
// Star:
//     StarWorldPosition - CameraWorldPosition
//
// Because the shader ray origin is zero, these values can be
// directly combined with camera-relative sample positions.
//

struct FAndromedaAtmosphereGPUData
{
    float CenterX;
    float CenterY;
    float SurfaceRadius;

    float CenterZ;
    float AtmosphereRadius;

    float Pad0;
    float Pad1;
    float Pad2;

    // ATMOS-05:
    // Finite point-star position, camera-relative.
    float StarPositionX;
    float StarPositionY;
    float StarPositionZ;

    // ATMOS-06: Rayleigh scattering parameters
    float RayleighScatteringX;
    float RayleighScatteringY;
    float RayleighScatteringZ;
    float RayleighScaleHeight;

    // Padding for 16-float (64-byte) structured buffer alignment
    float Pad3;
    float Pad4;
    float Pad5;
};

// =========================================================
// SHADER PARAMETERS
// =========================================================

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;

int2 ViewportSize;

float3 CameraWorldPosition;
float4x4 InvViewProjection;

int AtmosphereCount;

StructuredBuffer<FAndromedaAtmosphereGPUData> AtmosphereBuffer;

// ATMOS-04 DEPTH OCCLUSION
int DepthOcclusionEnabled;

// ATMOS-10: global exposure of the second-order term. 0 disables L2.
float MultipleScatteringScale;

// ATMOS-11: star validity flag from the renderer (1 = real star
// position available, 0 = star not yet provided). Must match
// FAndromedaAtmospherePS::FParameters::StarValid.
int StarValid;

// =========================================================
// ATMOS-04 CONSTANTS
// =========================================================

#define ATMOS_MARCH_STEPS 16

#define ATMOS_LIGHT_MARCH_STEPS 8

// ATMOS-10 multiple scattering quadrature resolution.
// Cost per view sample per atmosphere:
//     MS_DIRECTIONS x MS_STEPS coarse star-transmittance evaluations
//     (each MS_LIGHT_MARCH_STEPS long) plus segment transmittances.
#define ATMOS_MS_DIRECTIONS 4
#define ATMOS_MS_STEPS 3
#define ATMOS_MS_LIGHT_MARCH_STEPS 4

// ATMOS-11: display-referred exposure shared by the volume term and
// the sky radiance term. Same value as the approved ATMOS-09/10
// RayleighIntensityScale so surface sky lands in the same range.
#define ATMOS_RADIANCE_SCALE 8.0f

// =========================================================
// OPTICAL DEPTH SCALE
// =========================================================
// ATMOS-11: unity. The extinction integral uses the true Rayleigh
// coefficients, so optical depth, saturation, wavelength-dependent
// reddening and terminator contrast emerge from the transport.
//
// The previous look-dev value (0.008) multiplied every optical depth
// by ~1/125, forcing T ~= 1 on ALL paths (star, camera, segment).
// That mathematically precludes horizon saturation, sunset
// reddening and day/night extinction contrast: brightness reduced to
// sigma * path * phase, i.e. the smooth "gradient shell" reported by
// the ATMOS-11 visual test. Restoring unity is an architectural
// correction, not look-dev: scattering and extinction must share the
// same cross-section or the model is not energy-consistent.
// Verified low regression risk on current cm-scale planets: grazing
// limb chords hold OD ~0.08 (blue), so the approved limb stays
// transparent; only the missing saturation/reddening appear.
#define ATMOS_OPTICAL_DEPTH_SCALE 1.0f


// =========================================================
// RAY / SPHERE INTERSECTION
// =========================================================
//
// Same roots as:
//
//     |O + tD - C|² = R²
//
// with:
//
//     V = C - O
//
//     t = dot(V,D) +/- sqrt(dot(V,D)^2 - (|V|² - R²))
//
// The discriminant is normalized by R before evaluation to keep
// its magnitude near O(1), avoiding precision loss at huge
// world distances.
//
// THIS FUNCTION IS ATMOS-04 STABILIZATION AND MUST NOT BE
// REPLACED WITH THE ORIGINAL UNNORMALIZED FORM.
//

float2 RaySphereIntersect(
    float3 RayOrigin,
    float3 RayDir,
    float3 SphereCenter,
    float SphereRadius
)
{
    if (!(SphereRadius > 0.0f))
    {
        return float2(-1.0f, -1.0f);
    }

    float3 V = SphereCenter - RayOrigin;

    float B = dot(V, RayDir);

    float C =
        dot(V, V) -
        SphereRadius * SphereRadius;

    // Single normalization AFTER the dot products.
    float InvR =
        1.0f / SphereRadius;

    float Bn =
        B * InvR;

    float Cn =
        C * (InvR * InvR);

    float Discriminant =
        Bn * Bn -
        Cn;

    if (Discriminant < 0.0f)
    {
        return float2(-1.0f, -1.0f);
    }

    float SqrtD =
        sqrt(Discriminant);

    float T0 =
        (Bn - SqrtD) *
        SphereRadius;

    float T1 =
        (Bn + SqrtD) *
        SphereRadius;

    return float2(T0, T1);
}


// =========================================================
// ATMOS-06 RAYLEIGH DENSITY
// =========================================================
//
// Exponential density profile based on altitude above surface:
//     density = exp(-altitude / RayleighScaleHeight)
//
// Altitude is derived from distance to atmosphere center minus surface radius.
// Clamped to valid range [0, AtmosphereRadius - SurfaceRadius].
// Normalized to 1 at surface for consistent scaling with RayleighScattering coefficient.

float RayleighDensity(
    float DistFromCenter,
    float SurfaceRadius,
    float AtmosphereRadius,
    float RayleighScaleHeight
)
{
    float Altitude =
        DistFromCenter - SurfaceRadius;

    float ShellThickness =
        max(
            AtmosphereRadius - SurfaceRadius,
            1.0f
        );

    // Clamp altitude to valid atmospheric shell
    Altitude = clamp(Altitude, 0.0f, ShellThickness);

    // Effective scale height: honor RayleighScaleHeight while the shell can
    // resolve it; when the scale dwarfs the shell (e.g. 8 km scale over a
    // 0.5 km shell) the profile would be flat, so bind the effective scale
    // to the shell. Top-of-atmosphere density is then exp(-2.857) ~= 0.057,
    // giving a thin bright low-altitude core fading fast with altitude on
    // ANY planet size (reference: thin ISS limb line, not a diffuse band).
    // True Earth-like configurations (scale < shell) are unaffected.
    float EffectiveScaleHeight = min(
        max(RayleighScaleHeight, 1.0f),
        ShellThickness * 0.35f
    );

    // At surface (altitude=0): density = 1.0
    // At top of atmosphere: density = exp(-ShellThickness / EffectiveScaleHeight)
    return exp(-Altitude / EffectiveScaleHeight);
}


// =========================================================
// ATMOS-06 RAYLEIGH PHASE FUNCTION
// =========================================================
//
// Standard Rayleigh phase function:
//     P_R(theta) = 3 / (16*pi) * (1 + cos^2(theta))
//
// where cos(theta) = dot(ViewDir, LightDir)
// ViewDir points from sample to camera (normalized, opposite of RayDir)
// LightDir points from sample to star (normalized)
//
// The 3/(16*pi) normalization constant is folded into the RayleighScattering
// coefficient, so we return just (1 + cos^2(theta)).

float RayleighPhase(
    float3 ViewDir,
    float3 LightDir
)
{
    float CosTheta = dot(ViewDir, LightDir);
    float CosThetaSq = CosTheta * CosTheta;
    return 1.0f + CosThetaSq;
}


// =========================================================
// ATMOS-08 STAR TRANSMITTANCE
// =========================================================
//
// Computes the transmittance of stellar light along the path
// from the scattering sample to the star, through the atmosphere.
//
// The light ray is parameterized from the sample toward the star:
//
//     LightRayOrigin = SamplePos
//     LightRayDir = SampleToStarDirection
//
// The ray is integrated from the sample (inside atmosphere) outward
// to the atmosphere boundary, with planet-surface occlusion.
// CRITICAL: if the planet body lies between the sample and the star
// (star distance > planet surface intersection distance), the star
// is geometrically occulted and transmittance = 0.
//
// All distances are in camera-relative centimeters.
// RayleighScattering is on a km^-1 scale, so step length is
// converted to km before multiplication.
//
// Returns RGB transmittance (wavelength-dependent).
// =========================================================

float3 ComputeStarTransmittance(
    float3 SamplePos,
    float3 SampleToStarDirection,
    float3 RelCenter,
    float SurfaceRadius,
    float AtmosphereRadius,
    float RayleighScaleHeight,
    float3 RayleighScattering,
    int NumLightSteps,
    float3 StarPosition
)
{
    // Light ray: STAR -> SAMPLE (sample is inside atmosphere)
    float3 LightRayOrigin = SamplePos;
    float3 LightRayDir = SampleToStarDirection;

    // Distance from sample to star (along the ray)
    float StarDistance = length(StarPosition - SamplePos);

    // Intersect light ray with atmosphere outer boundary
    float2 TLightAtm = RaySphereIntersect(
        LightRayOrigin,
        LightRayDir,
        RelCenter,
        AtmosphereRadius
    );

    // No atmosphere intersection on light path
    if (TLightAtm.x < 0.0f && TLightAtm.y < 0.0f)
    {
        return float3(1.0f, 1.0f, 1.0f);
    }

    // Sample is inside atmosphere: entry is at 0, exit is at TLightAtm.y
    float LightEntryT = max(TLightAtm.x, 0.0f);
    float LightExitT = TLightAtm.y;

    // Check planet surface occlusion on light path
    float2 TLightSurf = RaySphereIntersect(
        LightRayOrigin,
        LightRayDir,
        RelCenter,
        SurfaceRadius
    );

    // Only clamp on genuine surface penetration. The separation test is
    // radius-relative: float32 discriminant noise at planetary radii
    // produces phantom root separations far above 1e-4 cm.
    if (TLightSurf.x >= 0.0f && TLightSurf.y > TLightSurf.x + SurfaceRadius * 2e-3f)
    {
        // Planet surface intersects the light ray.
        // If the star is BEYOND the planet surface (star distance > surface intersection),
        // the planet occults the star -> transmittance = 0.
        if (StarDistance > TLightSurf.x)
        {
            return float3(0.0f, 0.0f, 0.0f);
        }
        // Otherwise the star is in front of the planet surface (e.g. star between
        // sample and planet), so no occultation. Clamp the integration to the
        // atmosphere boundary as usual.
        LightExitT = min(LightExitT, TLightSurf.x);
    }

    // Invalid or zero-length light path.
    //
    // ATMOS-11 terminator fix: for a sample inside the atmosphere the
    // entry is 0 and the exit is the atmosphere boundary, so a
    // zero-length path here means the surface clamp pulled the exit
    // down to <= 0, i.e. the planet body occults the star along this
    // sample's star path. No direct stellar light reaches the sample:
    // transmittance is 0, not 1. (The old value of 1 leaked full
    // sunlight into partially DayGate-lit terminator samples.)
    // The no-atmosphere-intersection case already returned 1 above.
    if (!(LightExitT > LightEntryT))
    {
        return float3(0.0f, 0.0f, 0.0f);
    }

    // Fixed-step integration over light path
    const float CentimetersToKilometers = 0.00001f;
    float LightStepLen = (LightExitT - LightEntryT) / (float)max(NumLightSteps, 1);
    float LightStepLenKm = LightStepLen * CentimetersToKilometers;

    float3 OpticalDepth = float3(0.0f, 0.0f, 0.0f);

    for (int ls = 0; ls < NumLightSteps; ++ls)
    {
        float t = LightEntryT + LightStepLen * ((float)ls + 0.5f);
        float3 LightSamplePos = LightRayOrigin + LightRayDir * t;

        float DistFromCenter = length(LightSamplePos - RelCenter);

        float Density = RayleighDensity(
            DistFromCenter,
            SurfaceRadius,
            AtmosphereRadius,
            RayleighScaleHeight
        );

        // Extinction = Density * ScatteringCoefficient (per km).
        // ATMOS-11: ATMOS_OPTICAL_DEPTH_SCALE is unity (true physics);
        // kept symbolic so every transport term shares one convention.
        OpticalDepth += Density * RayleighScattering * LightStepLenKm * ATMOS_OPTICAL_DEPTH_SCALE;
    }

    // Transmittance = exp(-OpticalDepth), RGB
    float3 Transmittance = exp(-OpticalDepth);

    // Numerical safety
    if (!isfinite(Transmittance.x) || !isfinite(Transmittance.y) || !isfinite(Transmittance.z))
    {
        return float3(1.0f, 1.0f, 1.0f);
    }

    return Transmittance;
}


// =========================================================
// ATMOS-10 MULTIPLE SCATTERING (ORDER 2)
// =========================================================
//
// Radiative-transfer model (Bruneton-style scattering orders,
// evaluated at runtime, no LUT):
//
//   Order 1 (direct):
//       J1(Q -> observer) =
//           density(Q) * sigma_R * P_R * DayGate(Q) * T_star(Q)
//
//   Order 2 (diffuse):
//       Lin(P, Omega) = integral over segment P -> Q along Omega of
//           J1(Q -> P) * T(P -> Q) dQ        (gathered diffuse field)
//       J2(P -> camera) =
//           density(P) * sigma_R *
//           average_over_Omega[ Lin(P, Omega) * P_R(incident, view) ]
//
// The angular integral is a 4-direction tetrahedral quadrature.
// T_star(Q) uses a coarse light march (ATMOS_MS_LIGHT_MARCH_STEPS)
// while the view-march L1 keeps the full ATMOS_LIGHT_MARCH_STEPS.
// T(P -> Q) is a wavelength-dependent Beer-Lambert segment
// transmittance from the mean endpoint density.
//
// Crucially, J2 at P does NOT use DayGate(P) or T_star(P): diffuse
// light scatters at P even when P itself is in shadow. Day/night
// weighting lives inside the gathered J1(Q) sources, so terminator
// and night-side lift emerge from geometry + optical depth.
// =========================================================

float3 ComputeSegmentTransmittance(
    float3 P,
    float3 Q,
    float3 RelCenter,
    float SurfaceRadius,
    float AtmosphereRadius,
    float RayleighScaleHeight,
    float3 RayleighScattering
)
{
    float3 PQ = Q - P;
    float Dist = length(PQ);

    if (!(Dist > 0.0f) || !isfinite(Dist))
    {
        return float3(1.0f, 1.0f, 1.0f);
    }

    float DensP = RayleighDensity(
        length(P - RelCenter),
        SurfaceRadius,
        AtmosphereRadius,
        RayleighScaleHeight
    );

    float DensQ = RayleighDensity(
        length(Q - RelCenter),
        SurfaceRadius,
        AtmosphereRadius,
        RayleighScaleHeight
    );

    const float CentimetersToKilometers = 0.00001f;
    float DistKm = Dist * CentimetersToKilometers;

    float3 OpticalDepth =
        0.5f * (DensP + DensQ) *
        RayleighScattering * DistKm *
        ATMOS_OPTICAL_DEPTH_SCALE;

    float3 T = exp(-OpticalDepth);

    if (!isfinite(T.x + T.y + T.z))
    {
        return float3(1.0f, 1.0f, 1.0f);
    }

    return T;
}

// First-order source at Q scattering toward a given observer
// direction (normalized, Q -> observer). NumLightSteps selects
// full (view march) vs coarse (multiple-scattering gather) cost.
float3 ComputeFirstOrderSource(
    float3 Q,
    float3 QToObserverDir,
    float3 RelCenter,
    float SurfaceRadius,
    float AtmosphereRadius,
    float RayleighScaleHeight,
    float3 RayleighScattering,
    float3 StarPosition,
    int NumLightSteps
)
{
    float DensQ = RayleighDensity(
        length(Q - RelCenter),
        SurfaceRadius,
        AtmosphereRadius,
        RayleighScaleHeight
    );

    float3 ToStar = StarPosition - Q;
    float StarDistanceSq = dot(ToStar, ToStar);

    if (!(StarDistanceSq > 1e-8f))
    {
        return float3(0.0f, 0.0f, 0.0f);
    }

    float3 SunDir = ToStar * rsqrt(StarDistanceSq);

    // Star visibility is purely geometric: ComputeStarTransmittance
    // returns 0 when the planet body occults the star, and the
    // correct wavelength-dependent transmittance otherwise.
    // No artificial DayGate / surface-normal falloff is applied here.
    float3 TStar = ComputeStarTransmittance(
        Q,
        SunDir,
        RelCenter,
        SurfaceRadius,
        AtmosphereRadius,
        RayleighScaleHeight,
        RayleighScattering,
        NumLightSteps,
        StarPosition
    );

    // If the star is geometrically occulted, TStar = 0 and J1 = 0.
    if (!(TStar.x > 0.0f || TStar.y > 0.0f || TStar.z > 0.0f))
    {
        return float3(0.0f, 0.0f, 0.0f);
    }

    float Phase = RayleighPhase(QToObserverDir, SunDir);

    // Illumination = 1.0 (star radiance at top of atmosphere).
    // All angular dependence (cosine falloff, limb darkening) is
    // already captured by the Rayleigh phase function and the
    // geometric star transmittance along the long atmospheric path.
    // No smoothstep / pow on surface normal - that was an artistic
    // terminator hack that duplicated the geometric occlusion.
    return DensQ * Phase * RayleighScattering * TStar;
}

// Second-order local scattering at P toward the camera.
// ViewDir is normalized, sample -> camera.
float3 ComputeSecondOrderScattering(
    float3 P,
    float3 ViewDir,
    float3 RelCenter,
    float SurfaceRadius,
    float AtmosphereRadius,
    float RayleighScaleHeight,
    float3 RayleighScattering,
    float3 StarPosition
)
{
    float DensP = RayleighDensity(
        length(P - RelCenter),
        SurfaceRadius,
        AtmosphereRadius,
        RayleighScaleHeight
    );

    if (!(DensP > 0.0f))
    {
        return float3(0.0f, 0.0f, 0.0f);
    }

    // Tetrahedral quadrature directions (unit length 1/sqrt(3)).
    // Fixed in the camera-relative frame (translation only), giving
    // an unbiased 4pi average without per-sample frame construction.
    float InvSqrt3 = 0.57735026919f;
    float3 MsDirs[ATMOS_MS_DIRECTIONS];
    MsDirs[0] = float3(InvSqrt3, InvSqrt3, InvSqrt3);
    MsDirs[1] = float3(-InvSqrt3, InvSqrt3, -InvSqrt3);
    MsDirs[2] = float3(InvSqrt3, -InvSqrt3, -InvSqrt3);
    MsDirs[3] = float3(-InvSqrt3, -InvSqrt3, InvSqrt3);

    float3 IncidentSum = float3(0.0f, 0.0f, 0.0f);

    for (int j = 0; j < ATMOS_MS_DIRECTIONS; ++j)
    {
        float3 Omega = MsDirs[j];

        // Gather segment: from P outward to the atmosphere boundary,
        // truncated at the planet surface (diffuse blocked by planet).
        float2 TAtm = RaySphereIntersect(P, Omega, RelCenter, AtmosphereRadius);

        if (TAtm.y <= 0.0f)
        {
            continue;
        }

        float SegEnd = TAtm.y;

        float2 TSurf = RaySphereIntersect(P, Omega, RelCenter, SurfaceRadius);
        if (TSurf.x >= 0.0f && TSurf.y > TSurf.x + SurfaceRadius * 2e-3f)
        {
            SegEnd = min(SegEnd, TSurf.x);
        }

        if (!(SegEnd > 0.0f))
        {
            continue;
        }

        float StepLen = SegEnd / (float)ATMOS_MS_STEPS;

        const float CentimetersToKilometers = 0.00001f;
        float StepLenKm = StepLen * CentimetersToKilometers;

        float3 QToPDir = -Omega;

        float3 Gathered = float3(0.0f, 0.0f, 0.0f);

        for (int k = 0; k < ATMOS_MS_STEPS; ++k)
        {
            float3 Q = P + Omega * (StepLen * ((float)k + 0.5f));

            // First-order radiance at Q directed toward P.
            float3 J1 = ComputeFirstOrderSource(
                Q,
                QToPDir,
                RelCenter,
                SurfaceRadius,
                AtmosphereRadius,
                RayleighScaleHeight,
                RayleighScattering,
                StarPosition,
                ATMOS_MS_LIGHT_MARCH_STEPS
            );

            // Transport Q -> P through the participating medium.
            float3 Tpq = ComputeSegmentTransmittance(
                P,
                Q,
                RelCenter,
                SurfaceRadius,
                AtmosphereRadius,
                RayleighScaleHeight,
                RayleighScattering
            );

            Gathered += J1 * Tpq;
        }

        Gathered /= (float)ATMOS_MS_STEPS;
        Gathered *= StepLenKm;

        // Scatter the gathered diffuse field at P toward the camera.
        // Incident travel direction at P is -Omega.
        float Phase2 = RayleighPhase(ViewDir, -Omega);
        IncidentSum += Gathered * Phase2;
    }

    IncidentSum /= (float)ATMOS_MS_DIRECTIONS;

    // Second scattering event at P. The 3/(16pi) phase normalization
    // and solid-angle weights are folded into the display exposure
    // exactly like the L1 path (RayleighIntensityScale); the
    // MultipleScatteringScale uniform only gates/tunes L2.
    return DensP * RayleighScattering * IncidentSum * MultipleScatteringScale;
}


// =========================================================
// UNIFIED VIEW-RAY INTEGRATOR (SKY + GEOMETRY + SPACE)
// =========================================================
//
// ViewRadiance(observer, viewDir, atmosphere, star):
//
//     L = integral over [EntryT, ExitT] of
//             (J1(s) + J2(s)) * T(camera -> s) ds
//     Tout = T(camera -> ExitT)
//
// ONE integrator serves all three ray classes with the SAME
// atmospheric system (Hillaire-style single raymarch):
//
//   SKY RAY      [camera, atmosphere exit]  -> sky radiance,
//                                                background * Tout.
//   GEOMETRY RAY [camera, scene geometry]   -> aerial in-scatter L,
//                                                SceneColor * Tout.
//   SPACE VIEW   [atmosphere entry, exit]   -> limb radiance
//                                                (EntryT > 0 when the
//                                                camera is outside).
//
// J1(s) is the full first-order source (density, Rayleigh coeff,
// phase vs the finite point star, day-gate, star transmittance).
// J2(s) is the ATMOS-10 second-order term, so every ray class
// receives L1 + L2 through the shared transport functions - no
// separate sky-only or aerial-only scattering model exists.
//
// Extinction is wavelength-dependent (Rayleigh RGB) and shares one
// cross-section with scattering (ATMOS_OPTICAL_DEPTH_SCALE unity),
// so long horizon paths saturate and redden while short zenith
// paths stay blue - all from transport.
// Returns HDR radiance (ATMOS_RADIANCE_SCALE exposure family)
// and the residual transmittance for compositing.
// =========================================================

void ComputeViewRadiance(
    float3 RayDir,
    float EntryT,
    float ExitT,
    float3 RelCenter,
    float SurfaceRadius,
    float AtmosphereRadius,
    float RayleighScaleHeight,
    float3 RayleighScattering,
    float3 StarPosition,
    out float3 OutRadiance,
    out float3 OutTransmittance
)
{
    OutRadiance = float3(0.0f, 0.0f, 0.0f);
    OutTransmittance = float3(1.0f, 1.0f, 1.0f);

    float MarchLen = ExitT - EntryT;

    if (!(MarchLen > 0.0f))
    {
        return;
    }

    float StepLen = MarchLen / (float)ATMOS_MARCH_STEPS;

    const float CentimetersToKilometers = 0.00001f;
    float StepLenKm = StepLen * CentimetersToKilometers;

    // View direction is sample -> camera for every sky sample.
    float3 ViewDir = -RayDir;

    float3 TransmittanceAccum = float3(1.0f, 1.0f, 1.0f);
    float3 RadianceAccum = float3(0.0f, 0.0f, 0.0f);

    for (int s = 0; s < ATMOS_MARCH_STEPS; ++s)
    {
        float3 P = RayDir * (EntryT + StepLen * ((float)s + 0.5f));

        // First-order source toward the camera (full light march).
        float3 J1 = ComputeFirstOrderSource(
            P,
            ViewDir,
            RelCenter,
            SurfaceRadius,
            AtmosphereRadius,
            RayleighScaleHeight,
            RayleighScattering,
            StarPosition,
            ATMOS_LIGHT_MARCH_STEPS
        );

        // Second-order source toward the camera (ATMOS-10).
        float3 J2 = float3(0.0f, 0.0f, 0.0f);

        if (MultipleScatteringScale > 0.0f)
        {
            J2 = ComputeSecondOrderScattering(
                P,
                ViewDir,
                RelCenter,
                SurfaceRadius,
                AtmosphereRadius,
                RayleighScaleHeight,
                RayleighScattering,
                StarPosition
            );
        }

        float3 J = J1 + J2;

        // Wavelength-dependent extinction over this step.
        float DensP = RayleighDensity(
            length(P - RelCenter),
            SurfaceRadius,
            AtmosphereRadius,
            RayleighScaleHeight
        );

        float3 StepOpticalDepth =
            DensP * RayleighScattering * StepLenKm *
            ATMOS_OPTICAL_DEPTH_SCALE;

        float3 StepTransmittance = exp(-StepOpticalDepth);

        // Front-to-back: gather attenuated emission, then extend.
        RadianceAccum += TransmittanceAccum * J * StepLenKm;
        TransmittanceAccum *= StepTransmittance;
    }

    OutRadiance = RadianceAccum * ATMOS_RADIANCE_SCALE;
    OutTransmittance = TransmittanceAccum;
}


// =========================================================
// MAIN PIXEL SHADER
// =========================================================

void AndromedaAtmosphereMainPS(
    in float4 SvPosition : SV_Position,
    out float4 OutColor : SV_Target0
)
{
    // =====================================================
    // NORMALIZED VIEWPORT POSITION
    // =====================================================

    float2 UV =
        SvPosition.xy /
        max(
            float2(ViewportSize),
            float2(1.0f, 1.0f)
        );

    // =====================================================
    // ATMOS-04 RAY RECONSTRUCTION
    // =====================================================
    //
    // Baseline:
    //
    //     P_h = mul(Clip, M)
    //     P   = P_h.xyz / P_h.w
    //     Ray  = P - Camera
    //
    // Stable identity:
    //
    //     P - Camera
    //       = (P_h.xyz - Camera * P_h.w) / P_h.w
    //
    // The CPU has already calculated:
    //
    //     Ri - Camera * Wi
    //
    // in double precision.
    //
    // The shader only combines small camera-relative values.
    //
    // THIS IS THE EXACT ATMOS-04 NUMERICAL STABILIZATION.
    // =====================================================

    float4 ClipPos =
        float4(
            UV.x * 2.0f - 1.0f,
            1.0f - UV.y * 2.0f,
            1.0f,
            1.0f
        );

    float3 Row0 =
        float3(
            InvViewProjection[0][0],
            InvViewProjection[0][1],
            InvViewProjection[0][2]
        );

    float3 Row1 =
        float3(
            InvViewProjection[1][0],
            InvViewProjection[1][1],
            InvViewProjection[1][2]
        );

    float3 Row2 =
        float3(
            InvViewProjection[2][0],
            InvViewProjection[2][1],
            InvViewProjection[2][2]
        );

    float3 Row3 =
        float3(
            InvViewProjection[3][0],
            InvViewProjection[3][1],
            InvViewProjection[3][2]
        );

    float W0 =
        InvViewProjection[0][3];

    float W1 =
        InvViewProjection[1][3];

    float W2 =
        InvViewProjection[2][3];

    float W3 =
        InvViewProjection[3][3];

    float W =
        ClipPos.x * W0 +
        ClipPos.y * W1 +
        ClipPos.z * W2 +
        ClipPos.w * W3;

    if (!(W > 1e-6f) || !isfinite(W))
    {
        OutColor =
            float4(
                SceneColorTexture.Sample(
                    SceneColorSampler,
                    UV
                ).rgb,
                1.0f
            );

        return;
    }

    float3 Num =
        ClipPos.x * Row0 +
        ClipPos.y * Row1 +
        ClipPos.z * Row2 +
        ClipPos.w * Row3;

    float3 RayVec =
        Num / W;

    float RayLen =
        length(RayVec);

    if (
        !(RayLen > 0.0f) ||
        !isfinite(RayLen) ||
        !isfinite(
            dot(
                RayVec,
                float3(
                    1.0f,
                    1.0f,
                    1.0f
                )
            )
        )
    )
    {
        OutColor =
            float4(
                SceneColorTexture.Sample(
                    SceneColorSampler,
                    UV
                ).rgb,
                1.0f
            );

        return;
    }

    float3 RayDir =
        RayVec / RayLen;

    // Camera-relative origin.
    float3 RayOrigin =
        float3(
            0.0f,
            0.0f,
            0.0f
        );

    // =====================================================
    // SCENE COLOR
    // =====================================================

    float3 SceneColor =
        SceneColorTexture.Sample(
            SceneColorSampler,
            UV
        ).rgb;

    // =====================================================
    // ATMOS-04 DEPTH OCCLUSION
    // =====================================================

    float SceneDepthDeviceZ =
        1.0f;

    float SceneDepthW =
        0.0f;

    float DepthToRayScale =
        0.0f;

    if (DepthOcclusionEnabled != 0)
    {
        SceneDepthDeviceZ =
            SceneTexturesStruct.SceneDepthTexture.SampleLevel(
                SceneTexturesStruct.PointClampSampler,
                UV,
                0
            ).r;

        SceneDepthW =
            SceneDepthDeviceZ *
                View.InvDeviceZToWorldZTransform[0]
            +
            View.InvDeviceZToWorldZTransform[1]
            +
            1.0f /
            (
                SceneDepthDeviceZ *
                    View.InvDeviceZToWorldZTransform[2]
                -
                View.InvDeviceZToWorldZTransform[3]
            );

        // For every point on the ray:
        //
        //     W(t) = t * dot(RayDir, ViewZ)
        //
        // At the far reconstructed point:
        //
        //     W == RayLen * dot(RayDir, ViewZ)
        //
        // so:
        //
        //     W / RayLen
        //
        // is the per-ray conversion factor.

        DepthToRayScale =
            W / RayLen;
    }

    // =====================================================
    // ATMOS-09 AERIAL PERSPECTIVE: GEOMETRY DISTANCE
    // =====================================================
    //
    // Convert scene depth W to camera-ray distance.
    // W = t * dot(RayDir, ViewZ), so t = W / dot(RayDir, ViewZ)
    // The DepthToRayScale = W / RayLen gives us the conversion.
    // GeometryT is the distance along the ray to the scene geometry.
    // =====================================================

    float GeometryT = 1e10f;
    if (DepthOcclusionEnabled != 0 && SceneDepthW > 0.0f && DepthToRayScale > 0.0f)
    {
        GeometryT = SceneDepthW / DepthToRayScale;
        if (!(GeometryT > 0.0f) || !isfinite(GeometryT))
        {
            GeometryT = 1e10f;
        }
    }

    // =====================================================
    // ATMOSPHERE ACCUMULATION (ATMOS-06 + ATMOS-08 + ATMOS-09)
    // =====================================================

    float3 AccumulatedScattering =
        float3(
            0.0f,
            0.0f,
            0.0f
        );

    // Unified in-scattered radiance accumulator: sky radiance for
    // sky rays, aerial in-scatter for geometry rays, limb radiance
    // for space views - one integral per atmosphere, never counted
    // twice. Transmittance for whatever sits behind each segment.
    float3 SceneColorTransmittance = float3(1.0f, 1.0f, 1.0f);

    for (
        int i = 0;
        i < AtmosphereCount;
        ++i
    )
    {
        FAndromedaAtmosphereGPUData Atm =
            AtmosphereBuffer[i];

        float3 RelCenter =
            float3(
                Atm.CenterX,
                Atm.CenterY,
                Atm.CenterZ
            );

        float SurfaceRadius =
            Atm.SurfaceRadius;

        float AtmRadius =
            Atm.AtmosphereRadius;

        // =================================================
        // ATMOS-04 ATMOSPHERE INTERSECTION
        // =================================================

        float2 TAtm =
            RaySphereIntersect(
                RayOrigin,
                RayDir,
                RelCenter,
                AtmRadius
            );

        if (
            TAtm.x < 0.0f &&
            TAtm.y < 0.0f
        )
        {
            continue;
        }

        // =================================================
        // ENTRY / EXIT
        //
        // PROMPT 1 (depth/occlusion consolidation):
        // The old binary OcclusionFactor gate compared scene depth
        // against the ATMOSPHERE EXIT and zeroed the whole contribution.
        // That killed correctly-visible foreground atmosphere and never
        // shortened the march, so background atmosphere still leaked
        // through opaque geometry in the additive composite.
        // Occlusion is now enforced geometrically by clamping ExitT to
        // GeometryT below (same ray parameterization, same units).
        // =================================================

        float EntryT =
            (TAtm.x >= 0.0f)
                ? TAtm.x
                : 0.0f;

        float ExitT =
            TAtm.y;

        // Clamp at planet surface.
        float2 TSurf =
            RaySphereIntersect(
                RayOrigin,
                RayDir,
                RelCenter,
                SurfaceRadius
            );

        // Clamp ExitT only on genuine surface penetration. The separation
        // test must be radius-relative: float32 discriminant noise at
        // planetary radii produces phantom root separations far above
        // 1e-4 cm, which would truncate limb chords. Truly visible
        // surfaces still terminate the march via the GeometryT clamp
        // below, so the residual sub-epsilon interior error is invisible.
        //
        // ATMOS-11 ground-sky fix: the previous else-if skipped the ray
        // whenever the surface roots straddled zero while the camera was
        // inside the atmosphere shell (TSurf.x < 0 <= TSurf.y && TAtm.x
        // < 0). An observer standing ON the surface has the surface
        // sphere passing exactly through the ray origin, so EVERY upward
        // sky ray satisfied that condition and the entire ground sky was
        // discarded. The robust buried-observer test uses the real camera
        // distance instead: |RelCenter| in the camera-relative frame.
        // ZEPHYR-01: buried-observer test owned by the Zephyr
        // sky-domain library (mathematically identical to the
        // previous inline test: |RelCenter| vs SurfaceRadius).
        float CameraDistFromCenter = length(RelCenter);

        bool bCameraInsidePlanet =
            ZephyrIsBuriedObserver(
                CameraDistFromCenter,
                SurfaceRadius
            );

        if (bCameraInsidePlanet)
        {
            // Buried observer: every direction hits rock, no sky segment.
            continue;
        }

        if (TSurf.x >= 0.0f && TSurf.y > TSurf.x + SurfaceRadius * 2e-3f)
        {
            ExitT = min(ExitT, TSurf.x);
        }

        // Clamp the visible atmosphere interval to the first visible
        // scene geometry (was PROMPT 1 depth/occlusion consolidation).
        // GeometryT is the radial distance along the SAME normalized
        // camera ray, directly comparable to EntryT/ExitT. Defaults to
        // 1e10 when depth is disabled/invalid/sky, so this is a no-op
        // in those cases. Geometry in front of the atmosphere ->
        // ExitT < EntryT -> skip.
        ExitT = min(ExitT, GeometryT);

        if (!(ExitT > EntryT))
        {
            continue;
        }

        // No star, no light: when the renderer has not provided a star
        // position yet, the GPU buffer holds (0,0,0) = the camera
        // position, not a star. Integrating with it would treat the
        // camera as a point light (SunDir pointing back at the camera)
        // and generate nonphysical glow, including identical output
        // for any star configuration. Skip safely: with no stellar
        // source J1 = 0 everywhere and therefore J2 = 0 as well, so
        // skipping is exactly equivalent to integrating, only cheaper.
        // SceneColor passes through untouched.
        if (StarValid == 0)
        {
            continue;
        }

        // Star position for this atmosphere (camera-relative, from the
        // GPU buffer; consumed by every transport term below).
        float3 StarPosition =
            float3(
                Atm.StarPositionX,
                Atm.StarPositionY,
                Atm.StarPositionZ
            );

        float3 RayleighColor =
            float3(
                Atm.RayleighScatteringX,
                Atm.RayleighScatteringY,
                Atm.RayleighScatteringZ
            );

        // =================================================
        // UNIFIED VIEW INTEGRATION (SKY + GEOMETRY + SPACE)
        // =====================================================
        //
        // ONE front-to-back integration over [EntryT, ExitT] serves
        // every ray class with the same transport (J1 + J2, with
        // view-path extinction):
        //
        //   SKY RAY      ExitT = atmosphere exit  -> sky radiance;
        //                                             background dimmed
        //                                             by Tout.
        //   GEOMETRY RAY ExitT = scene geometry   -> aerial in-scatter;
        //                                             SceneColor dimmed
        //                                             by Tout.
        //   SPACE VIEW   EntryT > 0 (camera outside) -> limb radiance.
        //
        // The pre-unification code integrated geometry segments TWICE
        // (aerial x3 PLUS volume x8 over the identical interval with
        // the identical J1), washing distant terrain into an 11x
        // boosted haze that erased horizon contrast. A single count
        // restores it: terrain keeps its attenuated color, sky is sky.
        //
        // ATMOS-05 INVARIANT (preserved inside ComputeFirstOrderSource):
        // the star stays a finite point source - every sample evaluates
        // its own ToStar = StarPosition - SamplePos (both
        // camera-relative, i.e. StarWorld - SampleWorld exactly).
        // No global star direction is ever used.
        // =====================================================

        float3 ViewRadiance = float3(0.0f, 0.0f, 0.0f);
        float3 ViewTransmittance = float3(1.0f, 1.0f, 1.0f);

        ComputeViewRadiance(
            RayDir,
            EntryT,
            ExitT,
            RelCenter,
            SurfaceRadius,
            AtmRadius,
            Atm.RayleighScaleHeight,
            RayleighColor,
            StarPosition,
            ViewRadiance,
            ViewTransmittance
        );

        // Attenuate whatever sits behind the segment (scene geometry
        // color, or background space color for sky rays).
        SceneColorTransmittance *= ViewTransmittance;

        AccumulatedScattering += ViewRadiance;
    }

    // =====================================================
    // FULLSCREEN COMPOSITE
    // =====================================================
    //
    // SceneColor attenuated by every crossed atmosphere, plus the
    // unified in-scattered radiance (sky radiance and aerial
    // perspective are the same integral over different segments).
    // =====================================================

    OutColor =
        float4(
            SceneColor * SceneColorTransmittance +
            AccumulatedScattering,
            1.0f
        );
}
