// =========================================================
// ANDROMEDA ATMOSPHERE SYSTEM
// =========================================================
//
// ATMOS-04 - Diagnostic Ray Marching:
//     Reconstructs the camera ray per pixel, intersects every
//     atmosphere sphere, marches fixed samples entry->exit and
//     accumulates a stable normalized diagnostic density.
//
// ATMOS-05 - Finite Point-Star Transport:
//     The star is a finite-position point source. Its position is
//     supplied in the same camera-relative frame as the atmosphere.
//     For every ray-march sample we calculate:
//
//         Sample -> Star
//
//     and use the local planet-surface normal to determine:
//
//         Day / Terminator / Night
//
// No physical scattering, optical depth, transmittance or
// inverse-square luminosity model is implemented here.
// Those belong to later atmosphere milestones.
//
// Virtual path:
//     /Andromeda/AndromedaAtmosphere.usf
//
// Entry point:
//     AndromedaAtmosphereMainPS
//
// =========================================================

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"

// =========================================================
// GPU ATMOSPHERE DATA STRUCT
// =========================================================
//
// MUST match FAndromedaAtmosphereGPUData in
// AndromedaAtmosphereTypes.h exactly.
//
// All position values are camera-relative.
//
// Center:
//     AtmosphereCenterWorld - CameraWorldPosition
//
// Star:
//     StarWorldPosition - CameraWorldPosition
//
// Because the shader ray origin is zero, these values can be
// directly combined with camera-relative sample positions.
//

struct FAndromedaAtmosphereGPUData
{
    float CenterX;
    float CenterY;
    float SurfaceRadius;

    float CenterZ;
    float AtmosphereRadius;

    float Pad0;
    float Pad1;
    float Pad2;

    // ATMOS-05:
    // Finite point-star position, camera-relative.
    float StarPositionX;
    float StarPositionY;
    float StarPositionZ;
};

// =========================================================
// SHADER PARAMETERS
// =========================================================

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;

int2 ViewportSize;

float3 CameraWorldPosition;
float4x4 InvViewProjection;

int AtmosphereCount;

StructuredBuffer<FAndromedaAtmosphereGPUData> AtmosphereBuffer;

// ATMOS-04 DEPTH OCCLUSION
int DepthOcclusionEnabled;

// =========================================================
// ATMOS-04 CONSTANTS
// =========================================================

#define ATMOS_MARCH_STEPS 16


// =========================================================
// RAY / SPHERE INTERSECTION
// =========================================================
//
// Same roots as:
//
//     |O + tD - C|² = R²
//
// with:
//
//     V = C - O
//
//     t = dot(V,D) +/- sqrt(dot(V,D)^2 - (|V|² - R²))
//
// The discriminant is normalized by R before evaluation to keep
// its magnitude near O(1), avoiding precision loss at huge
// world distances.
//
// THIS FUNCTION IS ATMOS-04 STABILIZATION AND MUST NOT BE
// REPLACED WITH THE ORIGINAL UNNORMALIZED FORM.
//

float2 RaySphereIntersect(
    float3 RayOrigin,
    float3 RayDir,
    float3 SphereCenter,
    float SphereRadius
)
{
    if (!(SphereRadius > 0.0f))
    {
        return float2(-1.0f, -1.0f);
    }

    float3 V = SphereCenter - RayOrigin;

    float B = dot(V, RayDir);

    float C =
        dot(V, V) -
        SphereRadius * SphereRadius;

    // Single normalization AFTER the dot products.
    float InvR =
        1.0f / SphereRadius;

    float Bn =
        B * InvR;

    float Cn =
        C * (InvR * InvR);

    float Discriminant =
        Bn * Bn -
        Cn;

    if (Discriminant < 0.0f)
    {
        return float2(-1.0f, -1.0f);
    }

    float SqrtD =
        sqrt(Discriminant);

    float T0 =
        (Bn - SqrtD) *
        SphereRadius;

    float T1 =
        (Bn + SqrtD) *
        SphereRadius;

    return float2(T0, T1);
}


// =========================================================
// DIAGNOSTIC ATMOSPHERIC DENSITY
// =========================================================
//
// Normalized height:
//     0 = surface
//     1 = outer atmosphere
//
// Diagnostic density:
//     1 -> 0
//

float DiagnosticDensity(
    float DistFromCenter,
    float SurfaceRadius,
    float AtmosphereRadius
)
{
    float Shell =
        max(
            AtmosphereRadius -
            SurfaceRadius,
            1.0f
        );

    float H =
        saturate(
            (DistFromCenter -
             SurfaceRadius) /
            Shell
        );

    return 1.0f - H;
}


// =========================================================
// MAIN PIXEL SHADER
// =========================================================

void AndromedaAtmosphereMainPS(
    in float4 SvPosition : SV_Position,
    out float4 OutColor : SV_Target0
)
{
    // =====================================================
    // NORMALIZED VIEWPORT POSITION
    // =====================================================

    float2 UV =
        SvPosition.xy /
        max(
            float2(ViewportSize),
            float2(1.0f, 1.0f)
        );

    // =====================================================
    // ATMOS-04 RAY RECONSTRUCTION
    // =====================================================
    //
    // Baseline:
    //
    //     P_h = mul(Clip, M)
    //     P   = P_h.xyz / P_h.w
    //     Ray  = P - Camera
    //
    // Stable identity:
    //
    //     P - Camera
    //       = (P_h.xyz - Camera * P_h.w) / P_h.w
    //
    // The CPU has already calculated:
    //
    //     Ri - Camera * Wi
    //
    // in double precision.
    //
    // The shader only combines small camera-relative values.
    //
    // THIS IS THE EXACT ATMOS-04 NUMERICAL STABILIZATION.
    // =====================================================

    float4 ClipPos =
        float4(
            UV.x * 2.0f - 1.0f,
            1.0f - UV.y * 2.0f,
            1.0f,
            1.0f
        );

    float3 Row0 =
        float3(
            InvViewProjection[0][0],
            InvViewProjection[0][1],
            InvViewProjection[0][2]
        );

    float3 Row1 =
        float3(
            InvViewProjection[1][0],
            InvViewProjection[1][1],
            InvViewProjection[1][2]
        );

    float3 Row2 =
        float3(
            InvViewProjection[2][0],
            InvViewProjection[2][1],
            InvViewProjection[2][2]
        );

    float3 Row3 =
        float3(
            InvViewProjection[3][0],
            InvViewProjection[3][1],
            InvViewProjection[3][2]
        );

    float W0 =
        InvViewProjection[0][3];

    float W1 =
        InvViewProjection[1][3];

    float W2 =
        InvViewProjection[2][3];

    float W3 =
        InvViewProjection[3][3];

    float W =
        ClipPos.x * W0 +
        ClipPos.y * W1 +
        ClipPos.z * W2 +
        ClipPos.w * W3;

    if (!(W > 1e-6f) || !isfinite(W))
    {
        OutColor =
            float4(
                SceneColorTexture.Sample(
                    SceneColorSampler,
                    UV
                ).rgb,
                1.0f
            );

        return;
    }

    float3 Num =
        ClipPos.x * Row0 +
        ClipPos.y * Row1 +
        ClipPos.z * Row2 +
        ClipPos.w * Row3;

    float3 RayVec =
        Num / W;

    float RayLen =
        length(RayVec);

    if (
        !(RayLen > 0.0f) ||
        !isfinite(RayLen) ||
        !isfinite(
            dot(
                RayVec,
                float3(
                    1.0f,
                    1.0f,
                    1.0f
                )
            )
        )
    )
    {
        OutColor =
            float4(
                SceneColorTexture.Sample(
                    SceneColorSampler,
                    UV
                ).rgb,
                1.0f
            );

        return;
    }

    float3 RayDir =
        RayVec / RayLen;

    // Camera-relative origin.
    float3 RayOrigin =
        float3(
            0.0f,
            0.0f,
            0.0f
        );

    // =====================================================
    // SCENE COLOR
    // =====================================================

    float3 SceneColor =
        SceneColorTexture.Sample(
            SceneColorSampler,
            UV
        ).rgb;

    // =====================================================
    // ATMOS-04 DEPTH OCCLUSION
    // =====================================================

    float SceneDepthDeviceZ =
        1.0f;

    float SceneDepthW =
        0.0f;

    float DepthToRayScale =
        0.0f;

    if (DepthOcclusionEnabled != 0)
    {
        SceneDepthDeviceZ =
            SceneTexturesStruct.SceneDepthTexture.SampleLevel(
                SceneTexturesStruct.PointClampSampler,
                UV,
                0
            ).r;

        SceneDepthW =
            SceneDepthDeviceZ *
                View.InvDeviceZToWorldZTransform[0]
            +
            View.InvDeviceZToWorldZTransform[1]
            +
            1.0f /
            (
                SceneDepthDeviceZ *
                    View.InvDeviceZToWorldZTransform[2]
                -
                View.InvDeviceZToWorldZTransform[3]
            );

        // For every point on the ray:
        //
        //     W(t) = t * dot(RayDir, ViewZ)
        //
        // At the far reconstructed point:
        //
        //     W == RayLen * dot(RayDir, ViewZ)
        //
        // so:
        //
        //     W / RayLen
        //
        // is the per-ray conversion factor.

        DepthToRayScale =
            W / RayLen;
    }

    // =====================================================
    // ATMOSPHERE ACCUMULATION
    // =====================================================

    float3 AccumulatedDiag =
        float3(
            0.0f,
            0.0f,
            0.0f
        );

    for (
        int i = 0;
        i < AtmosphereCount;
        ++i
    )
    {
        FAndromedaAtmosphereGPUData Atm =
            AtmosphereBuffer[i];

        float3 RelCenter =
            float3(
                Atm.CenterX,
                Atm.CenterY,
                Atm.CenterZ
            );

        float SurfaceRadius =
            Atm.SurfaceRadius;

        float AtmRadius =
            Atm.AtmosphereRadius;

        // =================================================
        // ATMOS-04 ATMOSPHERE INTERSECTION
        // =================================================

        float2 TAtm =
            RaySphereIntersect(
                RayOrigin,
                RayDir,
                RelCenter,
                AtmRadius
            );

        if (
            TAtm.x < 0.0f &&
            TAtm.y < 0.0f
        )
        {
            continue;
        }

        // =================================================
        // ATMOS-04 DEPTH OCCLUSION GATE
        // =================================================

        float OcclusionFactor =
            1.0f;

        if (
            DepthOcclusionEnabled != 0 &&
            SceneDepthDeviceZ > 0.0f &&
            SceneDepthDeviceZ < 1.0f &&
            SceneDepthW > 0.0f
        )
        {
            float ExitW =
                TAtm.y *
                DepthToRayScale;

            if (
                ExitW > 0.0f &&
                SceneDepthW <
                    ExitW *
                    (1.0f - 1e-4f)
            )
            {
                OcclusionFactor =
                    0.0f;
            }
        }

        // =================================================
        // ENTRY / EXIT
        // =================================================

        float EntryT =
            (TAtm.x >= 0.0f)
                ? TAtm.x
                : 0.0f;

        float ExitT =
            TAtm.y;

        // Clamp at planet surface.
        float2 TSurf =
            RaySphereIntersect(
                RayOrigin,
                RayDir,
                RelCenter,
                SurfaceRadius
            );

        if (TSurf.x >= 0.0f)
        {
            ExitT =
                min(
                    ExitT,
                    TSurf.x
                );
        }
        else if (
            TSurf.y >= 0.0f &&
            TAtm.x < 0.0f
        )
        {
            continue;
        }

        if (!(ExitT > EntryT))
        {
            continue;
        }

        float MarchLen =
            ExitT - EntryT;

        if (
            !(MarchLen > 0.0f) ||
            !(MarchLen < 1e10f)
        )
        {
            continue;
        }

        // =================================================
        // ATMOS-05 FINITE POINT STAR
        // =================================================
        //
        // IMPORTANT:
        //
        // Do NOT calculate a single global star direction.
        //
        // The star is a finite point source, therefore every
        // sample must calculate:
        //
        //     ToStar = StarPosition - SamplePosition
        //
        // Since both are camera-relative, no large world-space
        // subtraction occurs here.
        //
        // StarPosition:
        //
        //     StarWorldPosition - CameraWorldPosition
        //
        // SamplePosition:
        //
        //     Camera-relative ray position
        //
        // Therefore:
        //
        //     ToStar =
        //         (StarWorld - Camera)
        //         -
        //         (SampleWorld - Camera)
        //
        // which is exactly:
        //
        //     StarWorld - SampleWorld
        //
        // in exact arithmetic.
        // =================================================

        float3 StarPosition =
            float3(
                Atm.StarPositionX,
                Atm.StarPositionY,
                Atm.StarPositionZ
            );

        // =================================================
        // FIXED-STEP MARCH
        // =================================================

        float StepLen =
            MarchLen /
            (float)ATMOS_MARCH_STEPS;

        float DensitySum =
            0.0f;

        for (
            int s = 0;
            s < ATMOS_MARCH_STEPS;
            ++s
        )
        {
            float T =
                EntryT +
                StepLen *
                ((float)s + 0.5f);

            // Camera-relative sample position.
            float3 SamplePos =
                RayDir * T;

            // =================================================
            // ATMOS-04 DENSITY GEOMETRY
            // =================================================

            float DistFromCenter =
                length(
                    SamplePos -
                    RelCenter
                );

            float BaseDensity =
                DiagnosticDensity(
                    DistFromCenter,
                    SurfaceRadius,
                    AtmRadius
                );

            // =================================================
            // ATMOS-05 SAMPLE -> STAR
            // =================================================

            float3 ToStar =
                StarPosition -
                SamplePos;

            float StarDistanceSq =
                dot(
                    ToStar,
                    ToStar
                );

            float3 SampleToStarDirection =
                float3(
                    0.0f,
                    0.0f,
                    0.0f
                );

            if (StarDistanceSq > 1e-8f)
            {
                SampleToStarDirection =
                    ToStar *
                    rsqrt(StarDistanceSq);
            }

            // =================================================
            // ATMOS-05 LOCAL PLANET NORMAL
            // =================================================
            //
            // The atmosphere is centered on the planet.
            // Using the planet center rather than the camera
            // gives the correct day/night boundary over the
            // spherical body.
            // =================================================

            float3 SurfaceNormal =
                SamplePos -
                RelCenter;

            float SurfaceNormalSq =
                dot(
                    SurfaceNormal,
                    SurfaceNormal
                );

            if (SurfaceNormalSq > 1e-8f)
            {
                SurfaceNormal *=
                    rsqrt(
                        SurfaceNormalSq
                    );
            }
            else
            {
                SurfaceNormal =
                    float3(
                        0.0f,
                        0.0f,
                        1.0f
                    );
            }

            // =================================================
            // DAY / TERMINATOR / NIGHT
            // =================================================
            //
            // +1:
            //     surface directly faces the star
            //
            //  0:
            //     terminator
            //
            // -1:
            //     surface faces away from the star
            //
            // smoothstep gives a soft terminator rather than
            // a hard binary day/night boundary.
            // =================================================

            float StarFacing =
                dot(
                    SurfaceNormal,
                    SampleToStarDirection
                );

            float DayFactor =
                smoothstep(
                    -0.10f,
                    0.10f,
                    StarFacing
                );

            // ATMOS-05 diagnostic lighting.
            //
            // A small night contribution is intentionally
            // retained so the atmosphere does not completely
            // disappear on the night side. Full physical
            // scattering/night illumination belongs to later
            // milestones.
            float NightFloor =
                0.08f;

            float StarLightContribution =
                lerp(
                    NightFloor,
                    1.0f,
                    DayFactor
                );

            float LocalDensity =
                BaseDensity *
                StarLightContribution;

            DensitySum +=
                LocalDensity;
        }

        // =================================================
        // ATMOS-04 DIAGNOSTIC VOLUME
        // =================================================

        float AvgDensity =
            DensitySum /
            (float)ATMOS_MARCH_STEPS;

        float ChordFactor =
            saturate(
                MarchLen /
                max(
                    AtmRadius,
                    1.0f
                )
            );

        float MarchIntensity =
            saturate(
                AvgDensity *
                ChordFactor
            );

        // =================================================
        // DIAGNOSTIC COLOR
        // =================================================

        float AtmPhase =
            (float)i *
            0.37f;

        float3 TintA =
            float3(
                0.04f,
                0.22f,
                0.55f
            );

        float3 TintB =
            float3(
                0.15f,
                0.75f,
                1.00f
            );

        float3 MarchColor =
            lerp(
                TintA,
                TintB,
                saturate(
                    AvgDensity +
                    AtmPhase *
                    0.15f
                )
            );

        AccumulatedDiag +=
            MarchColor *
            MarchIntensity *
            OcclusionFactor;
    }

    // =====================================================
    // FULLSCREEN ADDITIVE COMPOSITE
    // =====================================================

    OutColor =
        float4(
            SceneColor +
            AccumulatedDiag,
            1.0f
        );
}