#include "AndromedaNoiseLibrary.h"

namespace
{
    // =========================================================
    // HASH DETERMINISTICO DEL SEED
    //
    // Permette di usare seed fino a 16 cifre senza mai
    // trasformare direttamente il seed in coordinate enormi.
    //
    // Stesso seed -> stesso hash
    // Seed diverso -> hash diverso
    // =========================================================

    uint64 HashSeed(uint64 Seed)
    {
        Seed += 0x9E3779B97F4A7C15ULL;

        Seed =
            (Seed ^ (Seed >> 30)) *
            0xBF58476D1CE4E5B9ULL;

        Seed =
            (Seed ^ (Seed >> 27)) *
            0x94D049BB133111EBULL;

        return Seed ^ (Seed >> 31);
    }

    // =========================================================
    // CONVERSIONE HASH -> FLOAT DETERMINISTICO
    //
    // Produce un valore nell'intervallo [0, 1).
    // Usiamo 24 bit per mantenere una precisione stabile
    // quando il valore viene convertito in float.
    // =========================================================

    float HashToUnitFloat(uint64 Hash)
    {
        const uint32 Value =
            static_cast<uint32>(
                Hash & 0xFFFFFFULL
                );

        return
            static_cast<float>(Value) /
            16777216.0f;
    }

    // =========================================================
    // CREAZIONE OFFSET DEL SEED
    //
    // L'offset rimane volutamente piccolo.
    //
    // Non facciamo più:
    //
    // Seed * 12.9898
    //
    // perché con seed da 16 cifre produrrebbe coordinate
    // enormi e numericamente inadatte al campionamento del noise.
    // =========================================================

    FVector MakeSeedOffset(int64 Seed)
    {
        const uint64 BaseSeed =
            static_cast<uint64>(Seed);

        const uint64 HashX =
            HashSeed(BaseSeed);

        const uint64 HashY =
            HashSeed(HashX);

        const uint64 HashZ =
            HashSeed(HashY);

        const float X =
            HashToUnitFloat(HashX) * 200.0f - 100.0f;

        const float Y =
            HashToUnitFloat(HashY) * 200.0f - 100.0f;

        const float Z =
            HashToUnitFloat(HashZ) * 200.0f - 100.0f;

        return FVector(X, Y, Z);
    }
}

// =============================================================
// GENERAZIONE ALTEZZA PIANETA
// =============================================================

float UAndromedaNoiseLibrary::GeneratePlanetHeight(
    FVector Direction,
    int64 Seed,
    float ContinentalScale,
    float MountainScale,
    float DetailScale,
    float MountainStrength,
    float DetailStrength
)
{
    Direction =
        Direction.GetSafeNormal();

    // =========================================================
    // OFFSET DETERMINISTICO DEL SEED
    // =========================================================

    const FVector SeedOffset =
        MakeSeedOffset(Seed);

    // =========================================================
    // CONTINENTI
    // =========================================================

    const float ContinentalNoise =
        FMath::PerlinNoise3D(
            Direction * ContinentalScale +
            SeedOffset
        );

    const float Continental01 =
        (ContinentalNoise + 1.0f) * 0.5f;

    // =========================================================
    // MASCHERA MONTAGNE
    // =========================================================

    const float MountainMask =
        FMath::Clamp(
            (Continental01 - 0.50f) / 0.30f,
            0.0f,
            1.0f
        );

    // =========================================================
    // MONTAGNE
    // =========================================================

    const float MountainNoise =
        FMath::PerlinNoise3D(
            Direction * MountainScale +
            SeedOffset * 1.37f
        );

    const float Ridged =
        1.0f -
        FMath::Abs(
            MountainNoise
        );

    const float MountainShape =
        FMath::Pow(
            Ridged,
            3.0f
        );

    const float Mountains =
        MountainShape *
        MountainMask *
        MountainStrength;

    // =========================================================
    // DETTAGLIO
    // =========================================================

    const float DetailNoise =
        FMath::PerlinNoise3D(
            Direction * DetailScale +
            SeedOffset * 2.71f
        );

    const float Detail =
        DetailNoise *
        MountainMask *
        DetailStrength;

    // =========================================================
    // PIANURE
    // =========================================================

    const float LandMask =
        FMath::Clamp(
            (Continental01 - 0.42f) / 0.20f,
            0.0f,
            1.0f
        );

    const float Plains =
        FMath::Pow(
            LandMask,
            1.5f
        ) *
        0.25f;

    // =========================================================
    // ALTEZZA FINALE
    // =========================================================

    return
        Plains +
        Mountains +
        Detail;
}

// =============================================================
// NORMALE DELLA SUPERFICIE
// =============================================================

FVector UAndromedaNoiseLibrary::CalculatePlanetSurfaceNormal(
    FVector Direction,
    int64 Seed,
    float ContinentalScale,
    float MountainScale,
    float DetailScale,
    float MountainStrength,
    float DetailStrength,
    float TerrainHeight
)
{
    Direction =
        Direction.GetSafeNormal();

    // =========================================================
    // COSTRUZIONE DELLA BASE TANGENTE
    // =========================================================

    FVector ReferenceAxis =
        FVector::UpVector;

    if (FMath::Abs(
        FVector::DotProduct(
            Direction,
            ReferenceAxis
        )
    ) > 0.95f)
    {
        ReferenceAxis =
            FVector::ForwardVector;
    }

    const FVector Tangent =
        FVector::CrossProduct(
            ReferenceAxis,
            Direction
        ).GetSafeNormal();

    const FVector Bitangent =
        FVector::CrossProduct(
            Direction,
            Tangent
        ).GetSafeNormal();

    // =========================================================
    // CAMPIONAMENTO DEL TERRENO
    // =========================================================

    const float SampleDistance =
        0.0001f;

    const FVector DirectionTangent =
        (
            Direction +
            Tangent * SampleDistance
            ).GetSafeNormal();

    const FVector DirectionBitangent =
        (
            Direction +
            Bitangent * SampleDistance
            ).GetSafeNormal();

    const float CenterHeight =
        GeneratePlanetHeight(
            Direction,
            Seed,
            ContinentalScale,
            MountainScale,
            DetailScale,
            MountainStrength,
            DetailStrength
        ) *
        TerrainHeight;

    const float TangentHeight =
        GeneratePlanetHeight(
            DirectionTangent,
            Seed,
            ContinentalScale,
            MountainScale,
            DetailScale,
            MountainStrength,
            DetailStrength
        ) *
        TerrainHeight;

    const float BitangentHeight =
        GeneratePlanetHeight(
            DirectionBitangent,
            Seed,
            ContinentalScale,
            MountainScale,
            DetailScale,
            MountainStrength,
            DetailStrength
        ) *
        TerrainHeight;

    // =========================================================
    // POSIZIONI LOCALI
    // =========================================================

    const FVector CenterPosition =
        Direction *
        CenterHeight;

    const FVector TangentPosition =
        DirectionTangent *
        TangentHeight;

    const FVector BitangentPosition =
        DirectionBitangent *
        BitangentHeight;

    // =========================================================
    // TANGENTI DELLA SUPERFICIE
    // =========================================================

    const FVector SurfaceTangent =
        TangentPosition -
        CenterPosition;

    const FVector SurfaceBitangent =
        BitangentPosition -
        CenterPosition;

    // =========================================================
    // NORMALE
    // =========================================================

    FVector Normal =
        FVector::CrossProduct(
            SurfaceTangent,
            SurfaceBitangent
        ).GetSafeNormal();

    // =========================================================
    // CONTROLLO DEL VERSO
    // =========================================================

    if (FVector::DotProduct(
        Normal,
        Direction
    ) < 0.0f)
    {
        Normal *= -1.0f;
    }

    return Normal;
}

// =============================================================
// SURFACE DATA
// =============================================================

FPlanetSurfaceData UAndromedaNoiseLibrary::GetPlanetSurfaceData(
    FVector Direction,
    int64 Seed,
    float ContinentalScale,
    float MountainScale,
    float DetailScale,
    float MountainStrength,
    float DetailStrength,
    float TerrainHeight
)
{
    FPlanetSurfaceData SurfaceData;

    // =========================================================
    // DIREZIONE NORMALIZZATA
    // =========================================================

    Direction =
        Direction.GetSafeNormal();

    SurfaceData.Direction =
        Direction;

    // =========================================================
    // ALTEZZA NORMALIZZATA
    // =========================================================

    SurfaceData.NormalizedHeight =
        GeneratePlanetHeight(
            Direction,
            Seed,
            ContinentalScale,
            MountainScale,
            DetailScale,
            MountainStrength,
            DetailStrength
        );

    // =========================================================
    // ALTEZZA FISICA
    // =========================================================

    SurfaceData.Height =
        SurfaceData.NormalizedHeight *
        TerrainHeight;

    // =========================================================
    // NORMALE DELLA SUPERFICIE
    // =========================================================

    SurfaceData.Normal =
        CalculatePlanetSurfaceNormal(
            Direction,
            Seed,
            ContinentalScale,
            MountainScale,
            DetailScale,
            MountainStrength,
            DetailStrength,
            TerrainHeight
        );

    return SurfaceData;
}

// =============================================================
// GENERAZIONE VERTICI
// =============================================================

void UAndromedaNoiseLibrary::GeneratePlanetVertices(
    int32 Resolution,
    float PlanetRadius,
    int32 FaceIndex,
    int64 Seed,
    float ContinentalScale,
    float MountainScale,
    float DetailScale,
    float MountainStrength,
    float DetailStrength,
    float TerrainHeight,
    TArray<FVector>& OutVertices
)
{
    OutVertices.Reset();

    if (Resolution < 2)
    {
        return;
    }

    const int32 VertexCount =
        Resolution *
        Resolution;

    OutVertices.Reserve(
        VertexCount
    );

    for (int32 Row = 0;
        Row < Resolution;
        ++Row)
    {
        for (int32 Col = 0;
            Col < Resolution;
            ++Col)
        {
            const float U =
                static_cast<float>(Col) /
                static_cast<float>(Resolution - 1);

            const float V =
                static_cast<float>(Row) /
                static_cast<float>(Resolution - 1);

            const float X =
                U * 2.0f -
                1.0f;

            const float Y =
                V * 2.0f -
                1.0f;

            FVector CubePosition;

            // =================================================
            // MAPPATURA DELLE 6 FACCE
            // =================================================

            switch (FaceIndex)
            {
            case 0:
                CubePosition =
                    FVector(
                        1.0f,
                        Y,
                        X
                    );
                break;

            case 1:
                CubePosition =
                    FVector(
                        -1.0f,
                        Y,
                        -X
                    );
                break;

            case 2:
                CubePosition =
                    FVector(
                        X,
                        1.0f,
                        Y
                    );
                break;

            case 3:
                CubePosition =
                    FVector(
                        X,
                        -1.0f,
                        -Y
                    );
                break;

            case 4:
                CubePosition =
                    FVector(
                        X,
                        Y,
                        1.0f
                    );
                break;

            case 5:
                CubePosition =
                    FVector(
                        X,
                        -Y,
                        -1.0f
                    );
                break;

            default:
                CubePosition =
                    FVector::ForwardVector;
                break;
            }

            // =================================================
            // DIREZIONE SULLA SFERA
            // =================================================

            const FVector Direction =
                CubePosition.GetSafeNormal();

            // =================================================
            // ALTEZZA TERRAIN
            // =================================================

            const float Height =
                GeneratePlanetHeight(
                    Direction,
                    Seed,
                    ContinentalScale,
                    MountainScale,
                    DetailScale,
                    MountainStrength,
                    DetailStrength
                ) *
                TerrainHeight;

            // =================================================
            // POSIZIONE FINALE
            // =================================================

            const float FinalRadius =
                PlanetRadius +
                Height;

            const FVector Vertex =
                Direction *
                FinalRadius;

            OutVertices.Add(
                Vertex
            );
        }
    }
}

// =============================================================
// GENERAZIONE MESH COMPLETA
// =============================================================

void UAndromedaNoiseLibrary::GeneratePlanetMeshData(
    int32 Resolution,
    float PlanetRadius,
    int64 Seed,
    float ContinentalScale,
    float MountainScale,
    float DetailScale,
    float MountainStrength,
    float DetailStrength,
    float TerrainHeight,
    TArray<FVector>& OutVertices,
    TArray<int32>& OutTriangles,
    TArray<FVector>& OutNormals,
    TArray<FProcMeshTangent>& OutTangents
)
{
    OutVertices.Reset();
    OutTriangles.Reset();
    OutNormals.Reset();
    OutTangents.Reset();

    if (Resolution < 2)
    {
        return;
    }

    const int32 VerticesPerFace =
        Resolution *
        Resolution;

    const int32 TotalVertices =
        VerticesPerFace *
        6;

    OutVertices.Reserve(
        TotalVertices
    );

    OutTriangles.Reserve(
        (Resolution - 1) *
        (Resolution - 1) *
        6 *
        6
    );

    // =========================================================
    // GENERAZIONE VERTICI
    // =========================================================

    for (int32 FaceIndex = 0;
        FaceIndex < 6;
        ++FaceIndex)
    {
        TArray<FVector> FaceVertices;

        GeneratePlanetVertices(
            Resolution,
            PlanetRadius,
            FaceIndex,
            Seed,
            ContinentalScale,
            MountainScale,
            DetailScale,
            MountainStrength,
            DetailStrength,
            TerrainHeight,
            FaceVertices
        );

        OutVertices.Append(
            FaceVertices
        );
    }

    // =========================================================
    // GENERAZIONE TRIANGOLI
    // =========================================================

    for (int32 FaceIndex = 0;
        FaceIndex < 6;
        ++FaceIndex)
    {
        const int32 FaceOffset =
            FaceIndex *
            VerticesPerFace;

        const bool ReverseWinding =
            FaceIndex <= 3;

        for (int32 Row = 0;
            Row < Resolution - 1;
            ++Row)
        {
            for (int32 Col = 0;
                Col < Resolution - 1;
                ++Col)
            {
                const int32 A =
                    FaceOffset +
                    Row * Resolution +
                    Col;

                const int32 B =
                    A + 1;

                const int32 C =
                    A + Resolution;

                const int32 D =
                    C + 1;

                if (ReverseWinding)
                {
                    OutTriangles.Add(A);
                    OutTriangles.Add(B);
                    OutTriangles.Add(C);

                    OutTriangles.Add(C);
                    OutTriangles.Add(B);
                    OutTriangles.Add(D);
                }
                else
                {
                    OutTriangles.Add(A);
                    OutTriangles.Add(C);
                    OutTriangles.Add(B);

                    OutTriangles.Add(B);
                    OutTriangles.Add(C);
                    OutTriangles.Add(D);
                }
            }
        }
    }

    // =========================================================
    // NORMALI GEOMETRICHE
    // =========================================================

    OutNormals.SetNumZeroed(
        OutVertices.Num()
    );

    for (int32 TriangleIndex = 0;
        TriangleIndex < OutTriangles.Num();
        TriangleIndex += 3)
    {
        const int32 IndexA =
            OutTriangles[
                TriangleIndex
            ];

        const int32 IndexB =
            OutTriangles[
                TriangleIndex + 1
            ];

        const int32 IndexC =
            OutTriangles[
                TriangleIndex + 2
            ];

        const FVector A =
            OutVertices[IndexA];

        const FVector B =
            OutVertices[IndexB];

        const FVector C =
            OutVertices[IndexC];

        FVector FaceNormal =
            FVector::CrossProduct(
                B - A,
                C - A
            ).GetSafeNormal();

        // =====================================================
        // CONTROLLO NORMALE VERSO L'ESTERNO
        // =====================================================

        const FVector TriangleCenter =
            (A + B + C) /
            3.0f;

        const FVector OutwardDirection =
            TriangleCenter.GetSafeNormal();

        if (FVector::DotProduct(
            FaceNormal,
            OutwardDirection
        ) < 0.0f)
        {
            FaceNormal *= -1.0f;
        }

        OutNormals[IndexA] +=
            FaceNormal;

        OutNormals[IndexB] +=
            FaceNormal;

        OutNormals[IndexC] +=
            FaceNormal;
    }

    // =========================================================
    // SMOOTHING DEI VERTICI DUPLICATI
    // =========================================================

    TMap<FIntVector, TArray<int32>>
        VertexGroups;

    const double PositionScale =
        100000.0;

    for (int32 VertexIndex = 0;
        VertexIndex < OutVertices.Num();
        ++VertexIndex)
    {
        const FVector& Position =
            OutVertices[VertexIndex];

        const FIntVector Key(
            FMath::RoundToInt(
                Position.X *
                PositionScale
            ),
            FMath::RoundToInt(
                Position.Y *
                PositionScale
            ),
            FMath::RoundToInt(
                Position.Z *
                PositionScale
            )
        );

        VertexGroups
            .FindOrAdd(Key)
            .Add(VertexIndex);
    }

    for (const TPair<
        FIntVector,
        TArray<int32>>&Pair
        : VertexGroups)
    {
        FVector SmoothedNormal =
            FVector::ZeroVector;

        for (const int32 VertexIndex
            : Pair.Value)
        {
            SmoothedNormal +=
                OutNormals[
                    VertexIndex
                ];
        }

        SmoothedNormal =
            SmoothedNormal.GetSafeNormal();

        if (SmoothedNormal.IsNearlyZero())
        {
            SmoothedNormal =
                OutVertices[
                    Pair.Value[0]
                ].GetSafeNormal();
        }

        for (const int32 VertexIndex
            : Pair.Value)
        {
            OutNormals[
                VertexIndex
            ] =
                SmoothedNormal;
        }
    }

    // =========================================================
    // NORMALI FINALI
    // =========================================================

    for (int32 VertexIndex = 0;
        VertexIndex < OutNormals.Num();
        ++VertexIndex)
    {
        FVector Normal =
            OutNormals[
                VertexIndex
            ].GetSafeNormal();

        if (Normal.IsNearlyZero())
        {
            Normal =
                OutVertices[
                    VertexIndex
                ].GetSafeNormal();
        }

        const FVector OutwardDirection =
            OutVertices[
                VertexIndex
            ].GetSafeNormal();

        if (FVector::DotProduct(
            Normal,
            OutwardDirection
        ) < 0.0f)
        {
            Normal *= -1.0f;
        }

        OutNormals[
            VertexIndex
        ] =
            Normal;
    }

    // =========================================================
    // TANGENTI
    // =========================================================

    OutTangents.SetNum(
        OutVertices.Num()
    );

    for (int32 VertexIndex = 0;
        VertexIndex < OutVertices.Num();
        ++VertexIndex)
    {
        const FVector Normal =
            OutNormals[
                VertexIndex
            ];

        FVector ReferenceAxis =
            FVector::UpVector;

        if (FMath::Abs(
            FVector::DotProduct(
                Normal,
                ReferenceAxis
            )
        ) > 0.95f)
        {
            ReferenceAxis =
                FVector::ForwardVector;
        }

        FVector Tangent =
            FVector::CrossProduct(
                ReferenceAxis,
                Normal
            ).GetSafeNormal();

        if (Tangent.IsNearlyZero())
        {
            Tangent =
                FVector::RightVector;
        }

        OutTangents[
            VertexIndex
        ] =
            FProcMeshTangent(
                Tangent,
                false
            );
    }
}